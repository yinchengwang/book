/* pages/detail/detail.wxss */

.page {
  padding: 24rpx;
}

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: var(--text-muted);
}

.title-block {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: var(--shadow);
}

.title-block .title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.4;
  color: var(--text);
}

.title-block .meta-line {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  font-size: 26rpx;
  color: var(--text-muted);
}

.title-block .tag-list {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.title-block .tag-list .tag {
  font-size: 22rpx;
  color: var(--primary-dark);
  background: #fff1e6;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.gallery {
  margin-top: 24rpx;
  background: white;
  border-radius: 24rpx;
  padding: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  box-shadow: var(--shadow);
}

.gallery .photo image {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
}

.notes-block {
  background: white;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-top: 24rpx;
  box-shadow: var(--shadow);
}
.notes-block .notes-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-muted);
  margin-bottom: 12rpx;
}
.notes-block .notes-body {
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--text);
  white-space: pre-wrap;
}

.bottom-actions {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  padding: 24rpx;
  background: var(--bg);
  border-top: 1rpx solid var(--border);
}

.btn {
  border: none;
  border-radius: 100rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  width: 100%;
}
.btn.danger {
  background: #fff0ed;
  color: #c0392b;
  border: 1rpx solid #f5cdc4;
}
