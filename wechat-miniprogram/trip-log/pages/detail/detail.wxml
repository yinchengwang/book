<!-- pages/detail/detail.wxml -->
<view wx:if="{{trip}}" class="page">
  <view class="title-block">
    <view class="title">{{trip.title}}</view>
    <view class="meta-line">
      <text class="meta-item">📅 {{trip.dateText}}</text>
      <text wx:if="{{trip.location}}" class="meta-item">📍 {{trip.location}}</text>
      <text wx:if="{{trip.weather}}" class="meta-item">🌤 {{trip.weather}}</text>
    </view>
    <view wx:if="{{trip.companions}}" class="meta-line">
      <text class="meta-item">👥 {{trip.companions}}</text>
    </view>
    <view wx:if="{{trip.tagsText}}" class="tag-list">
      <text wx:for="{{trip.tags}}" wx:key="*this" wx:for-item="t" class="tag">#{{t}}</text>
    </view>
  </view>

  <view wx:if="{{trip.photos && trip.photos.length > 0}}" class="gallery">
    <view wx:for="{{trip.photos}}" wx:key="url" wx:for-item="p" class="photo" bindtap="previewImg" data-url="{{p.url}}" data-index="{{index}}">
      <image src="{{p.url}}" mode="aspectFill" />
    </view>
  </view>

  <view wx:if="{{trip.notes}}" class="notes-block">
    <view class="notes-title">感想</view>
    <view class="notes-body">{{trip.notes}}</view>
  </view>

  <view style="height:200rpx"></view>

  <view class="bottom-actions">
    <button class="btn danger" bindtap="deleteTrip">删除</button>
  </view>
</view>

<view wx:elif="{{loading}}" class="loading">载入中…</view>
<view wx:else class="empty-state">
  <view class="icon">😶</view>
  <view class="title">记录找不到了</view>
</view>
