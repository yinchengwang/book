/* pages/index/index.wxss */

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 0;
}

.loading {
  text-align: center;
  color: var(--text-muted);
  padding: 80rpx 0;
}

.group-header {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-dark);
  margin: 32rpx 0 16rpx 8rpx;
  letter-spacing: 2rpx;
}

.trip-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  overflow: hidden;
}

.trip-card .cover image {
  width: 100%;
  height: 360rpx;
  display: block;
  background: #eee;
}

.trip-card .body {
  padding: 24rpx 28rpx 28rpx;
}

.trip-card .title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.trip-card .meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.trip-card .meta-item {
  margin-right: 4rpx;
}

.trip-card .tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.trip-card .tag {
  font-size: 22rpx;
  color: var(--primary-dark);
  background: #fff1e6;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.trip-card .notes {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-muted);
  line-height: 1.6;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.trip-card .photo-more {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-faint);
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: 60rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: white;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 126, 62, 0.45);
  z-index: 100;
}

.fab .plus {
  font-size: 52rpx;
  line-height: 1;
  margin-top: -8rpx;
}
.fab .fab-label {
  font-size: 20rpx;
  margin-top: 2rpx;
}

.cloud-hint {
  position: fixed;
  left: 24rpx; right: 24rpx;
  bottom: 220rpx;
  background: #fff8e6;
  border: 1rpx solid #f3d790;
  color: #7a5a16;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  z-index: 50;
}
