<!-- pages/index/index.wxml — 时间线主页 -->
<view class="page">
  <view wx:if="{{loading && trips.length === 0}}" class="loading">载入中…</view>

  <block wx:elif="{{trips.length === 0}}">
    <view class="empty-state">
      <view class="icon">⛰️</view>
      <view class="title">还没有任何足迹</view>
      <view class="hint">{{cloudHint || '点右下角的「＋」开始记第一次出发吧'}}</view>
    </view>
  </block>

  <block wx:else>
    <view wx:for="{{grouped}}" wx:key="key" wx:for-item="group">
      <view class="group-header">{{group.label}}</view>
      <view wx:for="{{group.items}}" wx:key="id" wx:for-item="trip" class="trip-card" bindtap="openTrip" data-id="{{trip.id}}">
        <view wx:if="{{trip.cover}}" class="cover">
          <image src="{{trip.cover}}" mode="aspectFill" />
        </view>
        <view class="body">
          <view class="title">{{trip.title}}</view>
          <view class="meta">
            <text class="meta-item">📅 {{trip.dateText}}</text>
            <text wx:if="{{trip.location}}" class="meta-item">📍 {{trip.location}}</text>
            <text wx:if="{{trip.weather}}" class="meta-item">🌤 {{trip.weather}}</text>
          </view>
          <view wx:if="{{trip.tagsText}}" class="tags">
            <text wx:for="{{trip.tags}}" wx:key="*this" wx:for-item="t" class="tag">#{{t}}</text>
          </view>
          <view wx:if="{{trip.notes}}" class="notes">{{trip.notes}}</view>
          <view wx:if="{{trip.photoCount > 1}}" class="photo-more">+{{trip.photoCount - 1}} 张照片</view>
        </view>
      </view>
    </view>
    <view style="height:180rpx"></view>
  </block>

  <view wx:if="{{cloudHint && trips.length > 0}}" class="cloud-hint">{{cloudHint}}</view>

  <!-- 浮动添加按钮 -->
  <view class="fab" bindtap="addTrip">
    <view class="plus">+</view>
    <view class="fab-label">新记录</view>
  </view>
</view>
