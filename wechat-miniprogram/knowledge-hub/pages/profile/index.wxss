.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--brand, #6366F1);
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.p-name {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.edit-btn {
  font-size: 26rpx;
  color: var(--brand);
  flex-shrink: 0;
}

.color-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
}

.color-dot.is-on {
  border-color: var(--text-primary);
}

.row-btn {
  height: 84rpx;
  width: 100%;
  font-size: 28rpx;
}

.import-box {
  min-height: 200rpx;
  margin: 16rpx 0;
}