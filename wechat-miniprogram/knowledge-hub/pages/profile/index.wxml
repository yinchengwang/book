<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <view class="page-body">

    <view class="page-head">
      <text class="page-title">我的</text>
      <text class="page-sub">资料 · 主题 · 数据</text>
    </view>

    <!-- 资料卡 -->
    <view class="card profile-card">
      <view class="avatar" bindtap="onOpenEdit">{{user.avatar}}</view>
      <view class="grow">
        <text class="p-name">{{user.name}}</text>
        <text class="t-caption">{{user.bio || '还没有简介'}}</text>
      </view>
      <view class="edit-btn" bindtap="onOpenEdit">编辑</view>
    </view>

    <!-- 主题模式 -->
    <view class="group-title">外观</view>
    <view class="card">
      <view class="chips">
        <view
          class="chip {{settings.theme === item.key ? 'is-active' : ''}}"
          wx:for="{{themeModes}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onPickTheme"
        >{{item.label}}</view>
      </view>
      <view class="divider"></view>
      <text class="field-label">主色</text>
      <view class="chips">
        <view
          class="color-dot {{settings.primaryColor === item.key ? 'is-on' : ''}}"
          wx:for="{{primaryColors}}"
          wx:key="key"
          style="background: {{item.light}};"
          data-key="{{item.key}}"
          bindtap="onPickPrimary"
        ></view>
      </view>
    </view>

    <!-- 数据管理 -->
    <view class="group-title">数据管理（{{usage.keys}} 项 · {{usage.currentSize}} KB）</view>
    <view class="card">
      <view class="btn-ghost row-btn" bindtap="onExport">导出备份（复制 JSON）</view>
      <view class="divider"></view>
      <textarea
        class="textarea import-box"
        value="{{importText}}"
        bindinput="onImportInput"
        placeholder="粘贴备份 JSON 后点击导入"
      />
      <view class="btn-ghost row-btn" bindtap="onImport">导入备份</view>
      <view class="divider"></view>
      <view class="btn-danger row-btn" bindtap="onClear">清空全部数据</view>
    </view>

    <view class="bottom-space"></view>
  </view>

  <!-- 编辑资料 -->
  <view class="panel" wx:if="{{showEdit}}">
    <view class="panel-head">
      <view class="panel-close" bindtap="onCloseEdit">×</view>
      <text class="panel-title">编辑资料</text>
      <view style="width: 64rpx;"></view>
    </view>
    <scroll-view class="panel-body" scroll-y>
      <view class="field">
        <text class="field-label">昵称</text>
        <input class="input" value="{{form.name}}" data-field="name" bindinput="onEditInput" placeholder="你的昵称" />
      </view>
      <view class="field">
        <text class="field-label">邮箱</text>
        <input class="input" value="{{form.email}}" data-field="email" bindinput="onEditInput" placeholder="可选" />
      </view>
      <view class="field">
        <text class="field-label">简介</text>
        <textarea class="textarea" value="{{form.bio}}" data-field="bio" bindinput="onEditInput" placeholder="一句话介绍" />
      </view>
      <view class="btn-primary" bindtap="onSaveProfile">保存</view>
    </scroll-view>
  </view>
</view>