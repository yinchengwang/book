/* 知识图谱 */

.chips {
  margin: 20rpx 0;
}

.sel-card {
  margin-top: 4rpx;
}

.sel-name {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.level-row {
  margin-top: 16rpx;
}

.level-btns {
  display: flex;
  gap: 12rpx;
}

.level-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 0.5px solid var(--border-strong);
  color: var(--text-primary);
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.level-btn:active {
  background: var(--bg-tertiary);
}

.rel-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0;
}

.rel-dir {
  font-size: 22rpx;
  color: var(--brand);
  background: var(--brand-soft, rgba(99, 102, 241, 0.12));
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.rel-name {
  font-size: 26rpx;
  color: var(--text-primary);
}

.rel-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.close-btn {
  margin-top: 20rpx;
  height: 72rpx;
  font-size: 26rpx;
}

.list-item.is-sel {
  border-color: var(--brand);
}