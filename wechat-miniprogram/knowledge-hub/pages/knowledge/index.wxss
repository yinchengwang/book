/* 知识聚合页 */

.gap-row {
  padding: 14rpx 0;
}

.gap-row + .gap-row {
  border-top: 0.5px solid var(--border);
}

.gap-label {
  font-size: 26rpx;
  color: var(--text-primary);
}

.gap-num {
  font-size: 22rpx;
  color: var(--text-muted);
}

.gap-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--warning);
}