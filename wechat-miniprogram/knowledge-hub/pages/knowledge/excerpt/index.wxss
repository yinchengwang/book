/* 摘抄管理 */

.search-input {
  margin: 16rpx 0;
}

.chips {
  margin-bottom: 12rpx;
}

.tag-chip {
  font-size: 22rpx;
}

.head-act {
  font-size: 26rpx;
  color: var(--brand);
  padding-right: 24rpx;
}

.ex-content {
  display: block;
