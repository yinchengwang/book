<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <view class="page-body">

    <view class="page-head">
      <text class="page-title">面试题库</text>
      <text class="page-sub">收藏 {{bookmarkCount}} 题 · 已浏览 {{viewedCount}} 题</text>
    </view>

    <view class="chips">
      <view
        class="chip {{bank === item.key ? 'is-active' : ''}}"
        wx:for="{{banks}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onSwitchBank"
      >{{item.label}}</view>
      <view class="chip {{showBookmarks ? 'is-active' : ''}}" bindtap="onToggleBookmarks">★ 收藏</view>
    </view>

    <view class="chips" wx:if="{{categories.length}}">
      <view
        class="chip {{category === item ? 'is-active' : ''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        data-cat="{{item}}"
        bindtap="onPickCategory"
      >{{item}}</view>
    </view>

    <input class="input search-input" value="{{query}}" bindinput="onSearch" placeholder="搜索题目" />

    <view
      class="list-item"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpen"
    >
      <view class="list-item-bar" style="background: {{item.bookmarked ? '#F5A524' : brand}};"></view>
      <view class="list-item-head">
        <text class="list-item-title">{{item.question}}</text>
        <text class="list-item-time" wx:if="{{item.viewed}}">已读</text>
      </view>
      <view class="list-item-meta">
        <text class="tag">{{item.category}}</text>
        <text class="tag">{{item.difficulty}}</text>
        <text class="tag tag-warning" wx:if="{{item.bookmarked}}">★ 已收藏</text>
      </view>
    </view>

    <app-empty wx:if="{{list.length === 0}}" text="没有匹配的题目" />
    <view class="bottom-space"></view>
  </view>

  <!-- 题目详情 -->
  <view class="panel" wx:if="{{current}}">
    <view class="panel-head">
      <view class="panel-close" bindtap="onClose">×</view>
      <text class="panel-title">{{current.category}}</text>
      <view
        class="head-act"
        data-id="{{current.id}}"
        bindtap="onToggleBookmark"
      >{{current.bookmarked ? '★ 已收藏' : '☆ 收藏'}}</view>
    </view>
    <scroll-view class="panel-body" scroll-y>
      <text class="b-title">{{current.question}}</text>
      <view class="list-item-meta">
        <text class="tag tag-brand">{{current.difficulty}}</text>
        <text class="tag">{{current.category}}</text>
      </view>
      <view class="divider"></view>
      <rich-text nodes="{{html}}"></rich-text>
    </scroll-view>
  </view>
</view>