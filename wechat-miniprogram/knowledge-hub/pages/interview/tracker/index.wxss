/* 面试追踪 —— 列表 + 详情面板 */

.head-act {
  font-size: 26rpx;
  color: var(--brand);
  padding-right: 24rpx;
}

.d-position {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.d-notes {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.tl-card + .tl-card {
  margin-top: 16rpx;
}

.tl-type {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.tl-content {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  white-space: pre-wrap;
}