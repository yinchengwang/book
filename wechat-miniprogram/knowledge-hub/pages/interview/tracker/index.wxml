<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <view class="page-body">

    <view class="page-head">
      <text class="page-title">面试追踪</text>
      <text class="page-sub">共 {{list.length}} 家公司</text>
    </view>

    <view
      class="list-item"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpen"
    >
      <view class="list-item-bar" style="background: {{item.statusColor}};"></view>
      <view class="list-item-head">
        <text class="list-item-title">{{item.name}}</text>
        <text class="list-item-time">{{item.updated}}</text>
      </view>
      <text class="list-item-sub">{{item.position}}<text wx:if="{{item.salary}}"> · {{item.salary}}</text></text>
      <view class="list-item-meta">
        <text class="flag" style="background: {{item.statusColor}}1F; color: {{item.statusColor}};">{{item.status}}</text>
        <text class="tag">{{item.timelineCount}} 条记录</text>
      </view>
    </view>

    <app-empty wx:if="{{list.length === 0}}" text="还没有公司记录" action-text="添加公司" bind:action="onOpenAdd" />
    <view class="bottom-space"></view>
  </view>

  <app-fab bottom="{{140}}" bind:tap="onOpenAdd" />

  <!-- 详情面板 -->
  <view class="panel" wx:if="{{current}}">
    <view class="panel-head">
      <view class="panel-close" bindtap="onCloseDetail">×</view>
      <text class="panel-title">{{current.name}}</text>
      <view class="head-act" bindtap="onShareCompany">复制面经</view>
    </view>
    <scroll-view class="panel-body" scroll-y>
      <view class="card">
        <view class="row-between">
          <text class="d-position">{{current.position}}</text>
          <text class="flag" style="background: {{current.statusColor}}1F; color: {{current.statusColor}};">{{current.status}}</text>
        </view>
        <text class="t-caption" wx:if="{{current.salary}}">薪资 {{current.salary}}</text>
        <text class="d-notes" wx:if="{{current.notes}}">{{current.notes}}</text>
      </view>

      <view class="group-title">更新状态</view>
      <view class="chips">
        <view
          class="chip {{current.status === item.key ? 'is-active' : ''}}"
          wx:for="{{statuses}}"
          wx:key="key"
          data-status="{{item.key}}"
          bindtap="onChangeStatus"
        >{{item.label}}</view>
      </view>

      <view class="group-title">面试时间线</view>
      <view class="card tl-card" wx:for="{{current.timeline}}" wx:key="id">
        <view class="row-between">
          <text class="tl-type">{{item.typeLabel}}</text>
          <text class="t-caption num">{{item.date}}</text>
        </view>
        <text class="tl-content">{{item.content}}</text>
      </view>
      <app-empty wx:if="{{current.timeline.length === 0}}" text="还没有面试记录" />

      <view class="actions">
        <view class="act btn-primary" bindtap="onOpenRecord">添加记录</view>
      </view>
      <view class="btn-danger delete" bindtap="onDelete">删除公司</view>
    </scroll-view>
  </view>

  <!-- 新增公司 -->
  <view class="panel" wx:if="{{showAdd}}">
    <view class="panel-head">
      <view class="panel-close" bindtap="onCloseAdd">×</view>
      <text class="panel-title">添加公司</text>
      <view style="width: 64rpx;"></view>
    </view>
    <scroll-view class="panel-body" scroll-y>
      <view class="field">
        <text class="field-label">公司名</text>
        <input class="input" value="{{form.name}}" data-field="name" bindinput="onAddInput" placeholder="例如：字节跳动" />
      </view>
      <view class="field">
        <text class="field-label">岗位</text>
        <input class="input" value="{{form.position}}" data-field="position" bindinput="onAddInput" placeholder="后端开发" />
      </view>
      <view class="field">
        <text class="field-label">薪资（可选）</text>
        <input class="input" value="{{form.salary}}" data-field="salary" bindinput="onAddInput" placeholder="35-50K" />
      </view>
      <view class="field">
        <text class="field-label">备注</text>
        <textarea class="textarea" value="{{form.notes}}" data-field="notes" bindinput="onAddInput" placeholder="面试侧重、感受…" />
      </view>
      <view class="btn-primary" bindtap="onSaveCompany">添加</view>
    </scroll-view>
  </view>

  <!-- 新增面试记录 -->
  <view class="panel" wx:if="{{showRecord}}">
    <view class="panel-head">
      <view class="panel-close" bindtap="onCloseRecord">×</view>
      <text class="panel-title">添加面试记录</text>
      <view style="width: 64rpx;"></view>
    </view>
    <scroll-view class="panel-body" scroll-y>
      <view class="field">
        <text class="field-label">轮次</text>
        <view class="chips">
          <view
            class="chip {{recForm.type === item.key ? 'is-active' : ''}}"
            wx:for="{{recTypes}}"
            wx:key="key"
            data-type="{{item.key}}"
            bindtap="onPickRecType"
          >{{item.label}}</view>
        </view>
      </view>
      <view class="field">
        <text class="field-label">面试内容</text>
        <textarea class="textarea" value="{{recForm.content}}" data-field="content" bindinput="onRecInput" placeholder="问了什么、答得如何…" />
      </view>
      <view class="btn-primary" bindtap="onSaveRecord">保存记录</view>
    </scroll-view>
  </view>
</view>