/* 五年计划 —— 年份导航 / 打卡 / 月历网格 */

.theme-card {
  display: flex;
  flex-direction: column;
}

.theme-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.theme-core {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin: 24rpx 0;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg-tertiary);
  color: var(--text-primary);
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-btn.small {
  width: 52rpx;
  height: 52rpx;
  font-size: 30rpx;
}

.nav-label {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.habit-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}

.habit-row + .habit-row {
  border-top: 0.5px solid var(--border);
}

.habit-icon {
  font-size: 28rpx;
}

.habit-label {
  font-size: 26rpx;
  color: var(--text-primary);
}

.check-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border-strong);
  color: var(--brand);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.check-btn:active {
  background: var(--brand-soft, rgba(99, 102, 241, 0.12));
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.cal-month {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.cal-week {
  display: flex;
}

.cal-week-day {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
}

.cal-grid {
  display: flex;
  margin-top: 8rpx;
}

.cal-cell {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 6rpx;
  position: relative;
}

.cal-cell.is-empty {
  /* 空格 */
}

.cal-cell.is-today .cal-day {
  color: #FFFFFF;
  background: var(--brand);
  border-radius: 50%;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
}

.cal-day {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.cal-dot {
  width: 8rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: var(--bg-tertiary);
  margin-top: 4rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.cal-dot-fill {
  width: 100%;
  background: var(--brand);
  border-radius: 4rpx;
}

.cal-star {
  position: absolute;
  top: 2rpx;
  right: 6rpx;
  font-size: 16rpx;
  color: var(--warning);
}

.cal-legend {
  margin-top: 12rpx;
}

.p-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}