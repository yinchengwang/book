<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <view class="page-body">

    <view class="page-head">
      <text class="page-title">五年计划</text>
      <text class="page-sub">连续 {{streak}} 天 · 累计 {{totalDays}} 天</text>
    </view>

    <view class="card theme-card" wx:if="{{config}}">
      <text class="theme-title">{{year}} · {{config.theme}}</text>
      <text class="theme-core">{{config.core}}</text>
    </view>

    <!-- 年份导航 -->
    <view class="nav-row">
      <view class="nav-btn" data-delta="-1" bindtap="onShiftYear">‹</view>
      <text class="nav-label num">{{year}}</text>
      <view class="nav-btn" data-delta="1" bindtap="onShiftYear">›</view>
    </view>

    <!-- 今日快速打卡 -->
    <view class="group-title">今日打卡（本月 {{monthPct}}%）</view>
    <view class="card">
      <view class="habit-row" wx:for="{{habits}}" wx:key="id">
        <text class="habit-icon">{{item.icon}}</text>
        <text class="habit-label grow">{{item.label}}</text>
        <view class="check-btn" data-habit="{{item.id}}" bindtap="onQuickCheck">✓</view>
      </view>
    </view>

    <!-- 月历 -->
    <view class="group-title">打卡日历</view>
    <view class="card">
      <view class="cal-head">
        <view class="nav-btn small" data-delta="-1" bindtap="onShiftMonth">‹</view>
        <text class="cal-month num">{{year}} 年 {{month}} 月</text>
        <view class="nav-btn small" data-delta="1" bindtap="onShiftMonth">›</view>
      </view>
      <view class="cal-week">
        <text class="cal-week-day" wx:for="{{weeks}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="cal-grid" wx:for="{{days}}" wx:for-item="week" wx:key="week">
        <view
          class="cal-cell {{!item ? 'is-empty' : ''}} {{item.isToday ? 'is-today' : ''}}"
          wx:for="{{week}}"
          wx:key="index"
          data-day="{{item.day}}"
          bindtap="onOpenDay"
        >
          <text class="cal-day">{{item.day}}</text>
          <view class="cal-dot" wx:if="{{item}}">
            <view class="cal-dot-fill" style="height: {{item.fillPct}}%;"></view>
          </view>
          <view class="cal-star" wx:if="{{item.hasLearning}}">★</view>
        </view>
      </view>
      <view class="cal-legend">
        <text class="t-caption">★ 学习日 · 竖条高度表示当日完成度</text>
      </view>
    </view>

    <!-- 年度核心项目 -->
    <view class="group-title" wx:if="{{projects.length}}">年度核心项目</view>
    <view class="card" wx:for="{{projects}}" wx:key="name">
      <text class="p-name">{{item.name}}</text>
      <text class="t-caption">{{item.desc}}</text>
    </view>

    <view class="bottom-space"></view>
  </view>

  <!-- 单日编辑 -->
  <view class="panel" wx:if="{{showEdit}}">
    <view class="panel-head">
      <view class="panel-close" bindtap="onCloseEdit">×</view>
      <text class="panel-title">{{month}} 月 {{current}} 日</text>
      <view style="width: 64rpx;"></view>
    </view>
    <scroll-view class="panel-body" scroll-y>
      <view class="row-between">
        <text class="t-body">今日学习</text>
        <view class="check-btn" bindtap="onToggleLearning">{{editForm.hasLearning ? '✓' : '○'}}</view>
      </view>
      <view class="field">
        <text class="field-label">记录</text>
        <textarea class="textarea" value="{{editForm.note}}" bindinput="onEditInput" placeholder="今天学了什么…" />
      </view>
      <view class="actions">
        <view class="act btn-primary" bindtap="onSaveDay">保存</view>
      </view>
      <view class="btn-danger delete" bindtap="onDeleteDay">清空当日</view>
    </scroll-view>
  </view>
</view>