/* 学习路径 —— 横向路径 tab + 步骤卡 */

.path-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.path-tabs {
  display: inline-flex;
  gap: 16rpx;
}

.path-tab {
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

.path-tab.is-on {
  background: var(--brand-soft, rgba(99, 102, 241, 0.12));
  border-color: var(--brand, #6366F1);
}

.path-tab-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.path-tab-meta {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-muted);
}

.step-card {
  margin-bottom: 20rpx;
}

.step-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.step-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.sub-list {
  margin-top: 20rpx;
}

.sub-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}

.sub-item + .sub-item {
  border-top: 0.5px solid var(--border);
}

.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border-strong);
  color: #FFFFFF;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.check.is-on {
  background: var(--brand, #6366F1);
  border-color: var(--brand, #6366F1);
}

.sub-title {
  font-size: 26rpx;
  color: var(--text-primary);
}

.sub-title.is-done {
  color: var(--text-muted);
  text-decoration: line-through;
}

.sub-hours {
  font-size: 22rpx;
  color: var(--text-muted);
}

.res-list {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 0.5px solid var(--border);
}

.res-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 6rpx;
}

.res-item {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.reset-btn {
  height: 80rpx;
  font-size: 26rpx;
}