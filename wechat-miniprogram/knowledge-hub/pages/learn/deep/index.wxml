<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <view class="page-body">

    <view class="page-head">
      <text class="page-title">图解系列</text>
      <text class="page-sub">共 {{list.length}} 篇</text>
    </view>

    <view class="chips">
      <view
        class="chip {{activeStack === item.key ? 'is-active' : ''}}"
        wx:for="{{stacks}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onPickStack"
      >{{item.label}}</view>
    </view>

    <input class="input search-input" value="{{query}}" bindinput="onSearch" placeholder="搜索文章" />

    <view
      class="list-item"
      wx:for="{{list}}"
      wx:key="slug"
      data-slug="{{item.slug}}"
      bindtap="onOpen"
    >
      <view class="list-item-bar" style="background: {{item.color}};"></view>
      <view class="list-item-head">
        <text class="list-item-title">{{item.title}}</text>
        <text class="list-item-time">{{item.stackLabel}}</text>
      </view>
      <text class="list-item-sub">{{item.summary}}</text>
    </view>

    <app-empty wx:if="{{list.length === 0}}" text="没有匹配的文章" />
    <view class="bottom-space"></view>
  </view>

  <!-- 阅读面板 -->
  <view class="panel" wx:if="{{reading}}">
    <view class="panel-head">
      <view class="panel-close" bindtap="onClose">×</view>
      <text class="panel-title">{{reading.title}}</text>
      <view style="width: 64rpx;"></view>
    </view>
    <scroll-view class="panel-body" scroll-y>
      <rich-text nodes="{{html}}"></rich-text>
    </scroll-view>
  </view>
</view>