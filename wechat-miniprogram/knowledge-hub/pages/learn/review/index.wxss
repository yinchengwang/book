/* 复习计划 —— SM-2 卡片 + 评分 */

.flashcard {
  margin-top: 24rpx;
}

.q-title {
  display: block;
  margin: 20rpx 0;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.5;
}

.a-box {
  background: var(--bg-tertiary);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.a-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.7;
  white-space: pre-wrap;
}

.reveal-btn {
  height: 80rpx;
  font-size: 28rpx;
}

.quality-grid {
  display: flex;
  gap: 12rpx;
}

.quality-pill {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  border: 2rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.quality-pill:active {
  background: var(--bg-tertiary);
}

.quality-hint {
  display: block;
  margin-top: 12rpx;
  text-align: center;
}

.tag-del {
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--danger);
  background: rgba(229, 72, 77, 0.12);
  display: flex;
  align-items: center;
}