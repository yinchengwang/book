<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <view class="page-body">

    <view class="page-head">
      <text class="page-title">题库练习</text>
      <text class="page-sub">累计 {{stats.totalAnswered}} 题 · 正确率 {{stats.accuracyPct}}%</text>
    </view>

    <!-- ========== plan ========== -->
    <block wx:if="{{mode === 'plan'}}">
      <view class="card">
        <view class="row-between">
          <text class="card-title">今日计划</text>
          <text class="tag tag-brand">{{plan.stackLabel}}</text>
        </view>
        <view class="plan-num">
          <text class="num plan-done">{{plan.done}}</text>
          <text class="plan-total num"> / {{plan.total}} 题</text>
        </view>
        <progress-bar percent="{{planPercent}}" color="{{brand}}" />
        <view class="actions">
          <view class="act btn-primary" bindtap="onStartPlan">开始</view>
          <view class="act btn-ghost" bindtap="onRegeneratePlan">换一批</view>
        </view>
      </view>

      <view class="group-title">快速开练</view>
      <view
        class="entry"
        wx:for="{{stacks}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onStartStack"
      >
        <view class="entry-symbol" style="background: {{item.color}}1F; color: {{item.color}};">{{item.icon}}</view>
        <view class="entry-main">
          <text class="entry-title">{{item.label}} · 20 题</text>
        </view>
        <view class="entry-arrow"></view>
      </view>
    </block>

    <!-- ========== quiz ========== -->
    <block wx:if="{{mode === 'quiz'}}">
      <view class="card">
        <view class="row-between">
          <text class="tag tag-brand">{{q.stackLabel}}</text>
          <text class="t-caption num">{{q.position}}</text>
        </view>

        <view class="chips q-meta">
          <text class="chip-static">{{q.type}}</text>
          <text class="chip-static" style="color: {{q.difficultyColor}};">{{q.difficulty}}</text>
          <text class="chip-static">{{q.scenario}}</text>
        </view>

        <text class="q-stem">{{q.stem}}</text>
        <view class="code-block" wx:if="{{q.code}}">{{q.code}}</view>

        <!-- 选择题 / 判断题 -->
        <view
          class="opt"
          wx:for="{{options}}"
          wx:key="letter"
          data-letter="{{item.letter}}"
          bindtap="onPickOption"
        >
          <text class="opt-letter">{{item.letter}}</text>
          <text class="opt-text grow">{{item.text}}</text>
          <text class="opt-mark" wx:if="{{result}}">{{item.letter === result.right ? '✓' : ''}}</text>
        </view>

        <!-- 填空 / 简答 -->
        <view class="field" wx:if="{{options.length === 0}}">
          <text class="field-label">你的答案</text>
          <input class="input" value="{{picked}}" bindinput="onPickOption" data-letter="{{e.detail.value}}" placeholder="输入答案" />
        </view>

        <!-- 判分结果 -->
        <view class="result-box {{result.correct ? 'is-ok' : 'is-no'}}" wx:if="{{result}}">
          <text class="result-title">{{result.correct ? '回答正确' : '回答错误'}} · 正确答案 {{result.right}}</text>
          <text class="result-explain">{{result.explain}}</text>
        </view>

        <view class="actions">
          <view class="act btn-primary" wx:if="{{!result}}" bindtap="onSubmit">提交</view>
          <view class="act btn-primary" wx:else bindtap="onNext">下一题</view>
        </view>
        <view class="btn-ghost exit-btn" bindtap="onExitQuiz">结束本轮</view>
      </view>
    </block>

    <!-- ========== list ========== -->
    <block wx:if="{{mode === 'list'}}">
      <view class="chips search-chips">
        <view
          class="chip {{activeStack === item.key ? 'is-active' : ''}}"
          wx:for="{{stacks}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onPickStack"
        >{{item.label}}</view>
      </view>
      <input class="input" value="{{query}}" bindinput="onSearch" placeholder="搜索题干 / 场景" />

      <view class="list-item" wx:for="{{questions}}" wx:key="id" data-id="{{item.id}}" bindtap="onAnswerOne">
        <view class="list-item-bar" style="background: {{item.stackColor}};"></view>
        <view class="list-item-head">
          <text class="list-item-title">{{item.stem}}</text>
          <text class="list-item-time">{{item.type}}</text>
        </view>
        <view class="list-item-meta">
          <text class="tag">{{item.stackLabel}}</text>
          <text class="tag" style="color: {{item.difficultyColor}};">{{item.difficulty}}</text>
          <text class="tag">{{item.scenario}}</text>
        </view>
      </view>

      <app-empty wx:if="{{questions.length === 0}}" text="没有匹配的题目" />
    </block>

    <!-- ========== wrong ========== -->
    <block wx:if="{{mode === 'wrong'}}">
      <view class="btn-primary" wx:if="{{wrongs.length}}" bindtap="onStartWrong">重做错题（最多 10 题）</view>
      <view
        class="list-item"
        wx:for="{{wrongs}}"
        wx:key="questionId"
        data-id="{{item.questionId}}"
        bindtap="onAnswerOne"
      >
        <view class="list-item-bar" style="background: #E5484D;"></view>
        <view class="list-item-head">
          <text class="list-item-title">{{item.question.stem}}</text>
        </view>
        <view class="list-item-meta">
          <text class="tag tag-danger">你答：{{item.lastAnswer.userAnswer}}</text>
          <text class="tag tag-success">正确：{{item.question.answer}}</text>
        </view>
      </view>
      <app-empty wx:if="{{wrongs.length === 0}}" text="错题本是空的，继续保持" />
    </block>

    <!-- ========== stats ========== -->
    <block wx:if="{{mode === 'stats'}}">
      <view class="stat-grid">
        <view class="stat-cell">
          <text class="stat-value num">{{stats.totalAnswered}}</text>
          <text class="stat-label">累计答题</text>
        </view>
        <view class="stat-cell">
          <text class="stat-value num">{{stats.accuracyPct}}%</text>
          <text class="stat-label">正确率</text>
        </view>
        <view class="stat-cell">
          <text class="stat-value num">{{stats.streak}}</text>
          <text class="stat-label">连续天数</text>
        </view>
      </view>

      <view class="group-title">各栈进度</view>
      <view class="card">
        <view class="stack-row" wx:for="{{progress}}" wx:key="key">
          <view class="stack-dot" style="background: {{item.color}};"></view>
          <view class="grow">
            <view class="row-between">
              <text class="stack-label">{{item.label}}</text>
              <text class="stack-count num">{{item.correct}}/{{item.total}}</text>
            </view>
            <progress-bar percent="{{item.percent}}" color="{{item.color}}" />
          </view>
        </view>
      </view>
    </block>

    <view class="bottom-space"></view>
  </view>

  <!-- 底部模式切换 -->
  <view class="modebar">
    <view
      class="mode-item {{mode === 'plan' ? 'is-on' : ''}}"
      wx:for="{{['plan','list','quiz','wrong','stats']}}"
      wx:key="*this"
      data-mode="{{item}}"
      bindtap="onMode"
    >
      {{item === 'plan' ? '计划' : (item === 'list' ? '题库' : (item === 'quiz' ? '答题' : (item === 'wrong' ? '错题' : '统计')))}}
    </view>
  </view>
</view>