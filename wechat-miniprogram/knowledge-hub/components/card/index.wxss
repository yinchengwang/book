.card {
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
  border-radius: 24rpx;
  padding: 32rpx;
}

.card.is-tight {
  padding: 24rpx;
}

.card.is-flat {
  border-radius: 20rpx;
  padding: 24rpx;
}

.head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.extra {
  font-size: 22rpx;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
}
