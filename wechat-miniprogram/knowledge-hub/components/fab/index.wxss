.fab {
  position: fixed;
  right: 32rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 999rpx;
  background: var(--brand, #0284C7);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
  z-index: 50;
}

.fab.is-wide {
  width: auto;
  padding: 0 40rpx;
  gap: 12rpx;
}

.fab:active {
  opacity: 0.85;
}

/* 加号：两根线交叉，不依赖字体或图片 */
.plus {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.bar-h {
  position: absolute;
  top: 16rpx;
  left: 0;
  width: 36rpx;
  height: 3rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
}

.bar-v {
  position: absolute;
  left: 16rpx;
  top: 0;
  width: 3rpx;
  height: 36rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
}

.label {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}
