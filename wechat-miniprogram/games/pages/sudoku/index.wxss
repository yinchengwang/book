.page {
  min-height: 100vh;
  padding: 32rpx;
}

/* ============ 章节选择 ============ */

.menu-head {
  padding: 32rpx 8rpx 48rpx;
}

.menu-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
}

.menu-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #718096;
}

.chapter {
  background: #1a1a2e;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.chapter.is-locked {
  opacity: 0.45;
}

.chapter-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.chapter-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.chapter-stars {
  font-size: 24rpx;
  color: #667eea;
}

.level-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.level {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  background: #2d3748;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.level.is-locked {
  opacity: 0.35;
}

.level-id {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.level-stars {
  margin-top: 4rpx;
  font-size: 14rpx;
  line-height: 1;
}

.star {
  color: #4a5568;
}

.star.is-on {
  color: #ffd200;
}

/* ============ 游戏界面 ============ */

.statusbar {
  display: flex;
  background: #1a1a2e;
  border-radius: 20rpx;
  padding: 20rpx 0;
  margin-bottom: 24rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 20rpx;
  color: #718096;
}

.stat-value {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

/* 棋盘：9x9 栅格 */
.board {
  width: 100%;
  height: 620rpx;
  display: flex;
  flex-wrap: wrap;
  background: #4a5568;
  border-radius: 12rpx;
  overflow: hidden;
}

.cell {
  width: 11.111%;
  height: 11.111%;
  background: #2d3748;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 宫格分隔线 */
.cell.has-right {
  border-right: 3rpx solid #4a5568;
}

.cell.has-bottom {
  border-bottom: 3rpx solid #4a5568;
}

.cell.is-given {
  background: #1a202c;
}

.cell.is-conflict {
  background: #742a2a;
}

.cell.is-cursor {
  background: #667eea;
}

.cell-text {
  font-size: 40rpx;
  color: #667eea;
  font-weight: 500;
  line-height: 620rpx;
  text-align: center;
}

.cell.is-given .cell-text {
  color: #fff;
  font-weight: 700;
}

.cell.is-cursor .cell-text {
  color: #fff;
}

/* 光标移动栏 */
.toolbar {
  margin-top: 28rpx;
  display: flex;
  justify-content: center;
  gap: 24rpx;
}

.tool-btn {
  width: 96rpx;
  height: 72rpx;
  background: #1a1a2e;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #667eea;
}

.tool-btn:active {
  background: #667eea;
  color: #fff;
}

/* 数字键盘 */
.numpad {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.num {
  width: calc((100% - 64rpx) / 5);
  height: 96rpx;
  border-radius: 16rpx;
  background: #1a1a2e;
  color: #fff;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.num.is-active {
  background: #667eea;
}

.num-action {
  font-size: 26rpx;
  background: #2d3748;
  color: #a0aec0;
}

.num-hint {
  background: #553c9a;
  color: #fff;
}

/* 返回 */
.back-btn {
  margin-top: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #718096;
}

/* 通关弹窗 */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 15, 30, 0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.overlay-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
}

.overlay-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #718096;
}

.overlay-stars {
  margin-top: 32rpx;
  font-size: 64rpx;
}

.star-lg {
  color: #4a5568;
  margin: 0 8rpx;
}

.star-lg.is-on {
  color: #ffd200;
}

.overlay-btn {
  margin-top: 56rpx;
}

/* 成就 toast */
.achv-toast {
  position: fixed;
  top: 140rpx;
  left: 50%;
  margin-left: -160rpx;
  width: 320rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 24rpx;
  padding: 28rpx;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.4);
  z-index: 300;
}

.achv-toast-emoji {
  font-size: 60rpx;
}

.achv-toast-name {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}