.page {
  min-height: 100vh;
  padding: 32rpx;
}

/* 记分板 */
.scoreboard {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.score-box {
  flex: 1;
  background: #1a1a2e;
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
}

.score-label {
  font-size: 22rpx;
  color: #718096;
  margin-bottom: 8rpx;
}

/* 棋盘 */
.board-wrap {
  position: relative;
  width: 100%;
  height: 620rpx;
  background: #0f0f1e;
  border-radius: 20rpx;
  overflow: hidden;
}

.board {
  width: 100%;
  height: 100%;
}

/* 遮罩 */
.overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 15, 30, 0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.overlay-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.overlay-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #718096;
}

.overlay-btn {
  margin-top: 48rpx;
}

/* 方向键盘 */
.dpad {
  margin-top: 40rpx;
  display: flex;
  flex-wrap: wrap;
  width: 320rpx;
  margin-left: auto;
  margin-right: auto;
}

.dpad-btn {
  width: 100rpx;
  height: 100rpx;
  margin: 6rpx;
  background: #1a1a2e;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #667eea;
}

.dpad-btn:active {
  background: #667eea;
  color: #fff;
}

.dpad-center {
  width: 100rpx;
  height: 100rpx;
  margin: 6rpx;
}

.dpad-up {
  margin-left: 112rpx;
}

.hint {
  text-align: center;
  margin-top: 32rpx;
  font-size: 22rpx;
  color: #4a5568;
}

.pause-btn {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #718096;
}

/* 成就 toast */
.achv-toast {
  position: fixed;
  top: 140rpx;
  left: 50%;
  margin-left: -160rpx;
  width: 320rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 24rpx;
  padding: 28rpx;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.achv-toast-emoji {
  font-size: 60rpx;
}

.achv-toast-name {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}