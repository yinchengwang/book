<view class="page">
  <!-- ============ 章节选择 ============ -->
  <block wx:if="{{phase === 'menu'}}">
    <view class="menu-head">
      <view class="menu-title">开心消消乐</view>
      <view class="menu-sub">6 章 50 关 · 已获 {{totalStars}} ⭐</view>
    </view>

    <view
      class="chapter {{item.unlocked ? '' : 'is-locked'}}"
      wx:for="{{chapters}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onChapterTap"
    >
      <view class="chapter-head">
        <text class="chapter-name">
          第 {{item.id}} 章 · {{item.name}} {{item.unlocked ? '' : '🔒'}}
        </text>
        <text class="chapter-badge" style="color: {{item.typeColor}}">{{item.typeName}}</text>
      </view>

      <view class="chapter-desc">{{item.description}}</view>

      <view class="chapter-foot">
        <text class="chapter-levels">关卡 {{item.levelsText}}</text>
        <text class="chapter-progress">{{item.cleared}} / {{item.totalLevels}} 通关</text>
        <text class="chapter-stars">{{item.stars}} / {{item.maxStars}} ⭐</text>
      </view>

      <view
        class="chapter-enter"
        wx:if="{{item.unlocked}}"
        data-level="{{item.levels[0]}}"
        catchtap="onLevelTap"
      >进入第 {{item.levels[0]}} 关</view>
    </view>
  </block>

  <!-- ============ 游戏 ============ -->
  <block wx:else>
    <!-- 状态栏 -->
    <view class="statusbar">
      <view class="stat">
        <text class="stat-label">关卡</text>
        <text class="stat-value">{{chapter}}-{{level}}</text>
      </view>
      <view class="stat">
        <text class="stat-label">分数</text>
        <text class="stat-value score">{{score}}</text>
      </view>
      <view class="stat">
        <text class="stat-label">步数</text>
        <text class="stat-value">{{moves}}</text>
      </view>
    </view>

    <view class="chapter-tag" style="background: {{levelTypeColor}}">
      {{chapterName}} · {{levelTypeName}}
    </view>

    <!-- 目标 -->
    <view class="goals">
      <view class="goal" wx:for="{{goals}}" wx:key="type">
        <text class="goal-emoji">{{item.emoji}}</text>
        <text class="goal-text {{item.done ? 'is-done' : ''}}">
          {{item.current}} / {{item.target}}
        </text>
      </view>
    </view>

    <!-- 9x9 棋盘 -->
    <view class="board">
      <view
        class="cell {{selected === item.pos ? 'is-selected' : ''}}"
        wx:for="{{cells}}"
        wx:key="pos"
        data-pos="{{item.pos}}"
        bindtap="onCellTap"
      >
        <view
          class="gem {{item.hasGem ? '' : 'is-empty'}}"
          style="background: {{item.bg}}; box-shadow: 0 2rpx 0 {{item.shadow}};"
        >
          <text class="element" wx:if="{{item.elementEmoji}}">{{item.elementEmoji}}</text>
        </view>

        <view
          class="obstacle {{item.obstacleDestroyed ? 'is-broken' : ''}}"
          wx:if="{{item.obstacleEmoji}}"
          style="background: {{item.obstacleColor}}; border-color: {{item.obstacleBorder}};"
        >
          <text class="obstacle-emoji">{{item.obstacleEmoji}}</text>
          <text class="obstacle-hp" wx:if="{{item.obstacleMax > 1}}">{{item.obstacleHp}}</text>
        </view>
      </view>
    </view>

    <view class="hint">点击一个宝石，再点击相邻宝石完成交换</view>

    <view class="back-btn" bindtap="onBack">返回章节</view>

    <!-- 结算弹窗 -->
    <view class="overlay" wx:if="{{status === 'won' || status === 'lost'}}">
      <view class="overlay-title">
        {{status === 'won' ? '🎉 过关！' : '步数用尽'}}
      </view>
      <view class="overlay-sub">本局得分 {{score}}</view>

      <view class="overlay-stars" wx:if="{{status === 'won'}}">
        <text
          class="star-lg {{s <= stars ? 'is-on' : ''}}"
          wx:for="{{[1,2,3]}}"
          wx:for-item="s"
          wx:key="*this"
        >★</text>
      </view>

      <view class="overlay-actions">
        <button class="btn-ghost" bindtap="onBack">返回章节</button>
        <button class="btn-primary" bindtap="onRetry">再来一次</button>
      </view>
    </view>
  </block>

  <!-- 成就弹窗 -->
  <view class="achv-toast" wx:if="{{achievementToast}}">
    <view class="achv-toast-emoji">{{achievementToast.emoji}}</view>
    <view class="achv-toast-name">{{achievementToast.name}}</view>
  </view>
</view>