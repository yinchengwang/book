.page {
  min-height: 100vh;
  padding: 32rpx;
}

/* ============ 章节选择 ============ */

.menu-head {
  padding: 32rpx 8rpx 48rpx;
}

.menu-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
}

.menu-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #718096;
}

.chapter {
  background: #1a1a2e;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.chapter.is-locked {
  opacity: 0.45;
}

.chapter-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.chapter-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.chapter-badge {
  font-size: 22rpx;
  font-weight: 600;
}

.chapter-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #718096;
}

.chapter-foot {
  margin-top: 20rpx;
  display: flex;
  gap: 24rpx;
  font-size: 22rpx;
  color: #a0aec0;
}

.chapter-stars {
  color: #ffd200;
}

.chapter-enter {
  margin-top: 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: linear-gradient(135deg, #ee0979, #ff6a00);
  border-radius: 999rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

/* ============ 游戏界面 ============ */

.statusbar {
  display: flex;
  background: #1a1a2e;
  border-radius: 20rpx;
  padding: 20rpx 0;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 20rpx;
  color: #718096;
}

.stat-value {
  margin-top: 6rpx;
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}

.stat-value.score {
  color: #ffd200;
}

.chapter-tag {
  margin-top: 20rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 999rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

/* 目标 */
.goals {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.goal {
  display: flex;
  align-items: center;
  background: #1a1a2e;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}

.goal-emoji {
  font-size: 24rpx;
  margin-right: 10rpx;
}

.goal-text {
  font-size: 24rpx;
  color: #a0aec0;
}

.goal-text.is-done {
  color: #26de81;
  font-weight: 600;
}

/* 棋盘 */
.board {
  margin-top: 28rpx;
  width: 100%;
  height: 620rpx;
  display: flex;
  flex-wrap: wrap;
  background: #2d3748;
  border-radius: 16rpx;
  padding: 6rpx;
}

.cell {
  width: 11.111%;
  height: 11.111%;
  padding: 3rpx;
  position: relative;
}

.cell.is-selected {
  background: rgba(102, 126, 234, 0.35);
  border-radius: 8rpx;
}

.gem {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gem.is-empty {
  background: rgba(255, 255, 255, 0.04) !important;
  box-shadow: none !important;
}

.element {
  font-size: 32rpx;
}

/* 障碍物 */
.obstacle {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  right: 6rpx;
  bottom: 6rpx;
  border-radius: 10rpx;
  border: 2rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
}

.obstacle.is-broken {
  opacity: 0.3;
}

.obstacle-emoji {
  font-size: 26rpx;
  opacity: 0.9;
}

.obstacle-hp {
  position: absolute;
  right: 4rpx;
  bottom: 2rpx;
  font-size: 18rpx;
  color: #fff;
  font-weight: 700;
}

.hint {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #4a5568;
}

.back-btn {
  margin-top: 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #718096;
}

/* 结算弹窗 */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 15, 30, 0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.overlay-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
}

.overlay-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #718096;
}

.overlay-stars {
  margin-top: 32rpx;
  font-size: 64rpx;
}

.star-lg {
  color: #4a5568;
  margin: 0 8rpx;
}

.star-lg.is-on {
  color: #ffd200;
}

.overlay-actions {
  margin-top: 56rpx;
  display: flex;
  gap: 24rpx;
}

/* 成就 toast */
.achv-toast {
  position: fixed;
  top: 140rpx;
  left: 50%;
  margin-left: -160rpx;
  width: 320rpx;
  background: linear-gradient(135deg, #ee0979, #ff6a00);
  border-radius: 24rpx;
  padding: 28rpx;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.4);
  z-index: 300;
}

.achv-toast-emoji {
  font-size: 60rpx;
}

.achv-toast-name {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}