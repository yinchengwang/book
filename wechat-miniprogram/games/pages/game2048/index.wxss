.page {
  min-height: 100vh;
  padding: 32rpx;
}

.scoreboard {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.score-box {
  flex: 1;
  background: #1a1a2e;
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
}

.score-label {
  font-size: 22rpx;
  color: #718096;
  margin-bottom: 8rpx;
}

.board-wrap {
  position: relative;
  width: 100%;
  height: 620rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.board {
  width: 100%;
  height: 100%;
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 15, 30, 0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.overlay-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #ffd200;
}

.overlay-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #718096;
}

.overlay-btn {
  margin-top: 48rpx;
}

/* 胜利提示 */
.win-tip {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 15, 30, 0.94);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.win-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.win-actions {
  margin-top: 48rpx;
  display: flex;
  gap: 24rpx;
}

.dpad {
  margin-top: 40rpx;
  display: flex;
  flex-wrap: wrap;
  width: 320rpx;
  margin-left: auto;
  margin-right: auto;
}

.dpad-btn {
  width: 100rpx;
  height: 100rpx;
  margin: 6rpx;
  background: #1a1a2e;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #ffd200;
}

.dpad-btn:active {
  background: #ffd200;
  color: #1a1a2e;
}

.dpad-center {
  width: 100rpx;
  height: 100rpx;
  margin: 6rpx;
}

.dpad-up {
  margin-left: 112rpx;
}

.achv-toast {
  position: fixed;
  top: 140rpx;
  left: 50%;
  margin-left: -160rpx;
  width: 320rpx;
  background: linear-gradient(135deg, #f7971e, #ffd200);
  border-radius: 24rpx;
  padding: 28rpx;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.achv-toast-emoji {
  font-size: 60rpx;
}

.achv-toast-name {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}