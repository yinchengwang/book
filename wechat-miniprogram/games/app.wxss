/* app.wxss —— 全局样式 */

page {
  background: #16213e;
  color: #eaeaea;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  -webkit-font-smoothing: antialiased;
}

view, text, button, scroll-view {
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: #1a1a2e;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 48rpx;
  line-height: 88rpx;
  height: 88rpx;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: transparent;
  color: #a0aec0;
  border: 2rpx solid #4a5568;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 0 40rpx;
  line-height: 84rpx;
  height: 84rpx;
}

.btn-ghost::after {
  border: none;
}

/* 文本 */
.text-muted {
  color: #718096;
}

.text-accent {
  color: #667eea;
}

/* 分数显示 */
.score-value {
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
  font-variant-numeric: tabular-nums;
}