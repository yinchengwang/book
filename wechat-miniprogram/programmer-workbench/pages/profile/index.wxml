<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <view class="page-body">

    <!-- 资料卡 -->
    <view class="card profile-card">
      <view class="avatar">{{initial}}</view>
      <view class="profile-main">
        <text class="profile-name ellipsis">{{profile.nickname}}</text>
        <text class="profile-role">{{profile.role}}</text>
      </view>
      <view class="edit-btn" bindtap="onToggleEdit">{{editing ? '收起' : '编辑'}}</view>
    </view>

    <view class="motto" wx:if="{{profile.motto}}">「{{profile.motto}}」</view>
    <view class="bio" wx:if="{{profile.bio}}">{{profile.bio}}</view>

    <!-- 编辑面板 -->
    <view class="card edit-card" wx:if="{{editing}}">
      <view class="field">
        <text class="field-label">昵称</text>
        <input class="input" value="{{editForm.nickname}}" data-field="nickname" bindinput="onEditField" placeholder="怎么称呼你" placeholder-class="ph" />
      </view>
      <view class="field">
        <text class="field-label">角色</text>
        <input class="input" value="{{editForm.role}}" data-field="role" bindinput="onEditField" placeholder="例如：全栈工程师" placeholder-class="ph" />
      </view>
      <view class="field">
        <text class="field-label">座右铭</text>
        <input class="input" value="{{editForm.motto}}" data-field="motto" bindinput="onEditField" placeholder="一句提醒自己的话" placeholder-class="ph" />
      </view>
      <view class="field">
        <text class="field-label">简介</text>
        <textarea class="textarea" value="{{editForm.bio}}" data-field="bio" bindinput="onEditField" placeholder="简单介绍自己" placeholder-class="ph" />
      </view>
      <view class="edit-actions">
        <view class="btn-ghost act" bindtap="onToggleEdit">取消</view>
        <view class="btn-primary act" bindtap="onSaveProfile">保存</view>
      </view>
    </view>

    <!-- 外观 -->
    <view class="group-title">外观</view>
    <view class="card">
      <text class="row-label">主题</text>
      <view class="segmented">
        <view
          class="seg {{item.active ? 'is-active' : ''}}"
          wx:for="{{themes}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onSetTheme"
        >{{item.label}}</view>
      </view>

      <view class="divider"></view>

      <text class="row-label">主色</text>
      <view class="colors">
        <view
          class="color {{item.active ? 'is-active' : ''}}"
          wx:for="{{colors}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onSetPrimary"
        >
          <view class="color-dot" style="background: {{item.swatch}};"></view>
          <text class="color-label">{{item.label}}</text>
        </view>
      </view>

      <view class="divider"></view>

      <view class="switch-row">
        <view class="switch-main">
          <text class="row-label">操作振动反馈</text>
          <text class="row-sub">勾选待办、打卡时轻微振动</text>
        </view>
        <switch checked="{{haptics}}" color="{{brand}}" bindchange="onToggleHaptics" />
      </view>
    </view>

    <!-- 数据 -->
    <view class="group-title">数据</view>
    <view class="card">
      <view class="stat-grid">
        <view class="stat-cell" wx:for="{{stats}}" wx:key="label">
          <text class="stat-num num">{{item.value}}</text>
          <text class="stat-lab">{{item.label}}</text>
        </view>
      </view>

      <view class="divider"></view>

      <view class="menu-row" bindtap="onExport">
        <text class="menu-label">导出备份</text>
        <text class="menu-hint">复制到剪贴板</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="onImport">
        <text class="menu-label">从备份恢复</text>
        <text class="menu-hint">读取剪贴板</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="onClearData">
        <text class="menu-label is-danger">清空全部数据</text>
        <text class="menu-hint">不可撤销</text>
        <text class="menu-arrow">›</text>
      </view>

      <view class="usage">本机占用 {{usageText}}</view>
    </view>

    <!-- 更多 -->
    <view class="group-title">更多</view>
    <view class="card">
      <view class="menu-row" data-path="/pages/projects/index" bindtap="onGo">
        <text class="menu-label">项目集</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" data-path="/pages/insights/index" bindtap="onGo">
        <text class="menu-label">闪念</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="onAbout">
        <text class="menu-label">关于 DevBench</text>
        <text class="menu-hint">v{{version}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="foot">数据全部保存在本机，不上传任何服务器</view>
  </view>
</view>
