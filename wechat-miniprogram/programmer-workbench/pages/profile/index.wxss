/* 我的 —— 资料 / 外观 / 数据 */

.page-body {
  padding-top: 32rpx;
}

/* ==================== 资料卡 ==================== */

.profile-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--brand-soft, rgba(2, 132, 199, 0.12));
  color: var(--brand, #0284C7);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.profile-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.profile-name {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.profile-role {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.edit-btn {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 0.5px solid var(--border-strong);
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.edit-btn:active {
  background: var(--bg-tertiary);
}

.motto {
  margin: 20rpx 8rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.bio {
  margin: 8rpx 8rpx 0;
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.7;
}

/* ==================== 编辑面板 ==================== */

.edit-card {
  margin-top: 24rpx;
}

.ph {
  color: var(--text-muted);
}

.edit-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.act {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

/* ==================== 外观 ==================== */

.row-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.row-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 三段式选择器 */
.segmented {
  display: flex;
  background: var(--bg-tertiary);
  border-radius: 16rpx;
  padding: 6rpx;
}

.seg {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.seg.is-active {
  background: var(--bg-secondary);
  color: var(--text-primary);
  font-weight: 500;
}

/* 主色选择 */
.colors {
  display: flex;
  gap: 24rpx;
}

.color {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  border-radius: 16rpx;
  border: 0.5px solid transparent;
}

.color.is-active {
  border-color: var(--border-strong);
  background: var(--bg-tertiary);
}

.color-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.color.is-active .color-dot {
  box-shadow: 0 0 0 4rpx var(--bg-secondary), 0 0 0 6rpx currentColor;
}

.color-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-main {
  flex: 1;
  min-width: 0;
}

.switch-main .row-label {
  margin-bottom: 0;
}

/* ==================== 数据 ==================== */

.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx 8rpx;
}

.stat-cell {
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.stat-lab {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 菜单行 */
.menu-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 0.5px solid var(--border);
}

.menu-row:last-of-type {
  border-bottom: none;
}

.menu-row:active {
  background: var(--bg-tertiary);
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.menu-label.is-danger {
  color: var(--danger);
}

.menu-hint {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-right: 8rpx;
}

.menu-arrow {
  font-size: 30rpx;
  color: var(--text-muted);
}

.usage {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 0.5px solid var(--border);
  font-size: 22rpx;
  color: var(--text-muted);
  text-align: center;
}

/* ==================== 底部 ==================== */

.foot {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
}
