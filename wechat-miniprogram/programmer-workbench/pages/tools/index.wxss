/* 工具箱 —— 搜索 + 网格 + 全屏面板 */

.page-head {
  padding: 40rpx 8rpx 8rpx;
}

.page-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ==================== 搜索 ==================== */

.search {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 20rpx;
  margin: 24rpx 0 32rpx;
  border-radius: 16rpx;
  background: var(--bg-tertiary);
}

/* 放大镜：圆 + 斜线，零图片资源 */
.search-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.glass {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid var(--text-muted);
  border-radius: 50%;
}

.handle {
  position: absolute;
  right: 5rpx;
  bottom: 5rpx;
  width: 12rpx;
  height: 3rpx;
  background: var(--text-muted);
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.ph {
  color: var(--text-muted);
}

.search-clear {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: var(--text-muted);
}

/* ==================== 工具网格 ==================== */

.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx 16rpx;
}

.tool {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tool:active .tool-icon {
  opacity: 0.7;
}

.tool-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: ui-monospace, Menlo, Monaco, monospace;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--brand, #0284C7);
}

.tool-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-primary);
}

.empty {
  padding: 96rpx 0;
  text-align: center;
}

/* ==================== 全屏面板 ==================== */

.panel {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--bg-primary);
  display: flex;
  flex-direction: column;
  z-index: 100;
}

.panel-head {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 24rpx;
  border-bottom: 0.5px solid var(--border);
  flex-shrink: 0;
}

.panel-symbol {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: var(--bg-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: ui-monospace, Menlo, Monaco, monospace;
  font-size: 24rpx;
  color: var(--brand, #0284C7);
  margin-right: 16rpx;
}

.panel-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.panel-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--text-secondary);
}

/* height:0 + flex:1 让 scroll-view 正确撑满剩余空间 */
.panel-body {
  flex: 1;
  height: 0;
  padding: 24rpx 32rpx 64rpx;
}

/* ==================== 选项胶囊 ==================== */

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.chip {
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: 0.5px solid var(--border);
  background: var(--bg-secondary);
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.chip.is-active {
  background: var(--brand, #0284C7);
  border-color: var(--brand, #0284C7);
  color: #FFFFFF;
}

/* ==================== 输入 / 输出 ==================== */

.field {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.out-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.copy {
  font-size: 24rpx;
  color: var(--brand, #0284C7);
  padding: 8rpx 0 8rpx 24rpx;
}

.err {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(229, 72, 77, 0.1);
  color: var(--danger);
  font-size: 24rpx;
  line-height: 1.5;
}

.note {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.6;
}

/* ==================== 当前时间戳卡片 ==================== */

.now-card {
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.now-row {
  display: flex;
  align-items: center;
}

.now-label {
  width: 140rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.now-value {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

/* ==================== 键值行 ==================== */

.kv {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
}

.kv-k {
  width: 120rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.kv-v {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
  word-break: break-all;
}

/* ==================== UUID 列表 ==================== */

.uuid-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.uuid-row {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
}

.uuid-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-primary);
  word-break: break-all;
}

/* ==================== 正则高亮 ==================== */

.hl {
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
  font-family: ui-monospace, Menlo, Monaco, monospace;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-primary);
  word-break: break-all;
  white-space: pre-wrap;
}

.hl-seg.is-hit {
  background: var(--brand-soft, rgba(2, 132, 199, 0.12));
  color: var(--brand, #0284C7);
  border-radius: 4rpx;
}

/* ==================== 色块 ==================== */

.swatch {
  height: 160rpx;
  border-radius: 20rpx;
  border: 0.5px solid var(--border);
  margin-bottom: 20rpx;
}

/* ==================== Diff ==================== */

.diff {
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
  font-family: ui-monospace, Menlo, Monaco, monospace;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-primary);
  word-break: break-all;
  white-space: pre-wrap;
}

.diff-seg.is-add {
  background: rgba(48, 164, 108, 0.16);
  color: var(--success);
}

.diff-seg.is-del {
  background: rgba(229, 72, 77, 0.14);
  color: var(--danger);
  text-decoration: line-through;
}
