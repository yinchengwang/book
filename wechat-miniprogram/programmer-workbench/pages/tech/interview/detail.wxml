<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <app-header
    title="{{isEdit ? '编辑题目' : '新建题目'}}"
    showBack
    rightText="保存"
    bind:right="onSave"
  />

  <view class="page-body">
    <!-- 复习状态 -->
    <view class="review-bar" wx:if="{{isEdit}}">
      <view class="review-main">
        <text class="review-count num">已复习 {{reviewCount}} 次</text>
        <text class="review-time">{{lastReviewedText}}</text>
      </view>
      <view class="review-btn" bindtap="onMarkReviewed">标记已复习</view>
    </view>

    <view class="field">
      <text class="field-label">题目</text>
      <textarea
        class="textarea"
        value="{{question}}"
        placeholder="写下问题"
        placeholder-class="ph"
        bindinput="onQuestion"
        auto-height
      />
    </view>

    <view class="field">
      <text class="field-label">答案</text>
      <textarea
        class="textarea answer-area"
        value="{{answer}}"
        placeholder="整理你的答案要点"
        placeholder-class="ph"
        bindinput="onAnswer"
        auto-height
      />
    </view>

    <view class="field">
      <text class="field-label">难度</text>
      <view class="chips">
        <view
          class="chip {{item.active ? 'is-active' : ''}}"
          wx:for="{{difficulties}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onDifficulty"
          style="{{item.active ? 'background:' + item.color + ';border-color:' + item.color + ';' : ''}}"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="field">
      <text class="field-label">分类</text>
      <view class="chips">
        <view
          class="chip {{item.active ? 'is-active' : ''}}"
          wx:for="{{categories}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onCategory"
          style="{{item.active ? 'background:' + item.color + ';border-color:' + item.color + ';' : ''}}"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="field">
      <view class="editor-head">
        <text class="field-label">收藏</text>
        <text class="toggle" bindtap="onToggleStar">{{starred ? '已收藏' : '未收藏'}}</text>
      </view>
    </view>

    <view class="actions">
      <view class="btn-ghost act" bindtap="onMarkReviewed" wx:if="{{isEdit}}">标记已复习</view>
      <view class="btn-primary act" bindtap="onSave">保存</view>
    </view>

    <view class="btn-danger delete" wx:if="{{isEdit}}" bindtap="onDelete">删除这道题</view>
  </view>
</view>
