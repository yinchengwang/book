<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <app-header
    title="{{isEdit ? '编辑笔记' : '新建笔记'}}"
    showBack
    rightText="保存"
    bind:right="onSave"
  />

  <view class="page-body">
    <input
      class="title-input"
      value="{{formTitle}}"
      placeholder="标题"
      placeholder-class="ph"
      bindinput="onTitle"
    />

    <view class="field">
      <text class="field-label">分类</text>
      <view class="chips">
        <view
          class="chip {{item.active ? 'is-active' : ''}}"
          wx:for="{{categories}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onCategory"
          style="{{item.active ? 'background:' + item.color + ';border-color:' + item.color + ';' : ''}}"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="field">
      <text class="field-label">标签（逗号或空格分隔）</text>
      <input
        class="input"
        value="{{tagsText}}"
        placeholder="例如：react, hooks"
        placeholder-class="ph"
        bindinput="onTags"
      />
    </view>

    <view class="field">
      <view class="editor-head">
        <text class="field-label">内容（Markdown）</text>
        <text class="toggle" bindtap="onTogglePreview">{{preview ? '编辑' : '预览'}}</text>
      </view>

      <view class="preview-box" wx:if="{{preview}}">
        <rich-text
          wx:if="{{html}}"
          nodes="{{html}}"
          class="md-body"
          style="color: {{isDark ? '#E6EAF0' : '#0F172A'}}; font-size: 14px; line-height: 1.75;"
        ></rich-text>
        <text class="t-caption" wx:else>没有可预览的内容</text>
      </view>

      <textarea
        wx:else
        class="textarea mono"
        value="{{content}}"
        placeholder="支持 # 标题、**粗体**、`代码`、```代码块```"
        placeholder-class="ph"
        bindinput="onContent"
        auto-height
      />
    </view>

    <view class="actions">
      <view class="btn-ghost act" bindtap="onTogglePreview">{{preview ? '继续编辑' : '预览效果'}}</view>
      <view class="btn-primary act" bindtap="onSave">保存</view>
    </view>

    <view class="btn-danger delete" wx:if="{{isEdit}}" bindtap="onDelete">删除这篇笔记</view>
  </view>
</view>
