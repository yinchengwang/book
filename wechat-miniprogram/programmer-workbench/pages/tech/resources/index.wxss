/* 资源收藏 */

.summary {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 8rpx 20rpx;
}

.summary-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.is-archived {
  opacity: 0.6;
}

/* 卡片右侧星级：5 个小圆点 */
.stars {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  padding-left: 16rpx;
}

.star-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--border-strong);
}

.star-dot.is-on {
  background: var(--warning);
}

.arch {
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: var(--bg-tertiary);
  color: var(--text-muted);
  font-size: 20rpx;
  display: flex;
  align-items: center;
}

/* 星级选择器 */
.star-picker {
  display: flex;
  gap: 20rpx;
}

.star-pick {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2.5rpx solid var(--border-strong);
}

.star-pick.is-on {
  background: var(--warning);
  border-color: var(--warning);
}

.bottom-space {
  height: 160rpx;
}

/* ==================== 编辑面板 ==================== */

.panel {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--bg-primary);
  display: flex;
  flex-direction: column;
  z-index: 100;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 24rpx;
  border-bottom: 0.5px solid var(--border);
  flex-shrink: 0;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.panel-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--text-secondary);
}

.panel-body {
  flex: 1;
  height: 0;
  padding: 24rpx 32rpx 64rpx;
}
