<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <app-header title="闪念" showBack />

  <view class="page-body">
    <!-- 快速输入 -->
    <view class="quick">
      <input
        class="quick-input"
        value="{{quickText}}"
        placeholder="随手记一句…"
        placeholder-class="ph"
        confirm-type="done"
        bindinput="onQuickInput"
        bindconfirm="onQuickAdd"
      />
      <view class="quick-btn {{quickText ? 'is-on' : ''}}" bindtap="onQuickAdd">记下</view>
    </view>

    <view class="summary">
      <text class="summary-text">{{count}} 条闪念</text>
      <text class="summary-text" wx:if="{{pinnedCount > 0}}">· {{pinnedCount}} 条置顶</text>
    </view>

    <!-- 时间线 -->
    <view
      class="list-item {{item.archived ? 'is-archived' : ''}}"
      wx:for="{{items}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpen"
      bindlongpress="onLongPress"
    >
      <view class="list-item-bar" style="background: {{item.pinned ? 'var(--brand, #0284C7)' : 'var(--border-strong)'}};"></view>

      <text class="content">{{item.content}}</text>

      <view class="list-item-meta">
        <text class="flag" wx:if="{{item.pinned}}">置顶</text>
        <text class="flag flag-muted" wx:if="{{item.archived}}">已归档</text>
        <app-tag wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this" text="#{{t}}" />
        <text class="time">{{item.time}}</text>
      </view>
    </view>

    <app-empty
      wx:if="{{count === 0}}"
      text="还没有闪念，上面写一句试试"
    />
  </view>

  <!-- ==================== 编辑面板 ==================== -->
  <view class="panel" wx:if="{{editing}}">
    <view class="panel-head">
      <text class="panel-title">编辑闪念</text>
      <view class="panel-close" bindtap="onClosePanel">×</view>
    </view>

    <scroll-view scroll-y class="panel-body">
      <view class="field">
        <text class="field-label">内容</text>
        <textarea class="textarea content-area" value="{{formContent}}" placeholder="想法" placeholder-class="ph" bindinput="onFormContent" auto-height />
      </view>

      <view class="field">
        <text class="field-label">标签（逗号或空格分隔）</text>
        <input class="input" value="{{formTags}}" placeholder="例如：arch, tip" placeholder-class="ph" bindinput="onFormTags" />
      </view>

      <view class="field">
        <view class="editor-head">
          <text class="field-label">置顶</text>
          <text class="toggle" bindtap="onTogglePinned">{{formPinned ? '已置顶' : '未置顶'}}</text>
        </view>
      </view>

      <view class="field">
        <view class="editor-head">
          <text class="field-label">归档</text>
          <text class="toggle" bindtap="onToggleArchived">{{formArchived ? '已归档' : '未归档'}}</text>
        </view>
      </view>

      <view class="actions">
        <view class="btn-ghost act" bindtap="onClosePanel">取消</view>
        <view class="btn-primary act" bindtap="onSave">保存</view>
      </view>

      <view class="btn-danger delete" bindtap="onDelete">删除这条闪念</view>
    </scroll-view>
  </view>
</view>
