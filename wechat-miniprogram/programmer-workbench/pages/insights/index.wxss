/* 闪念 */

/* ==================== 快速输入 ==================== */

.quick {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0 24rpx;
}

.quick-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--bg-tertiary);
  font-size: 28rpx;
  color: var(--text-primary);
}

.quick-btn {
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 16rpx;
  background: var(--bg-tertiary);
  color: var(--text-muted);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.quick-btn.is-on {
  background: var(--brand, #0284C7);
  color: #FFFFFF;
}

/* ==================== 列表 ==================== */

.content {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.65;
  word-break: break-all;
}

.is-archived {
  opacity: 0.6;
}

.time {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-left: auto;
}

.content-area {
  min-height: 240rpx;
}
