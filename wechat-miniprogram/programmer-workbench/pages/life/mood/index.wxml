<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <app-header title="心情" showBack />

  <view class="page-body">
    <!-- 今日打卡 -->
    <view class="today-card">
      <view class="today-head">
        <text class="today-title">今天感觉如何</text>
        <text class="today-state">{{todayLabel}}</text>
      </view>
      <view class="today-dots">
        <view
          class="dot-wrap"
          wx:for="{{levels}}"
          wx:key="level"
          data-level="{{item.level}}"
          bindtap="onSetToday"
        >
          <view
            class="dot {{item.active ? 'is-active' : ''}}"
            style="{{item.active ? 'background:' + item.color + ';border-color:' + item.color + ';' : ''}}"
          ></view>
          <text class="dot-label {{item.active ? 'is-active' : ''}}">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 最近 14 天 -->
    <view class="strip-card">
      <view class="strip-head">
        <text class="strip-title">最近 {{strip.length}} 天</text>
        <text class="strip-streak">连续 {{streak}} 天</text>
      </view>
      <view class="strip">
        <view class="strip-cell" wx:for="{{strip}}" wx:key="date">
          <view
            class="strip-block {{item.isToday ? 'is-today' : ''}}"
            style="{{item.color ? 'background:' + item.color + ';' : ''}}"
          ></view>
          <text class="strip-day">{{item.day}}</text>
        </view>
      </view>
    </view>

    <!-- 历史记录 -->
    <view class="summary">
      <text class="summary-text">共 {{count}} 条记录</text>
    </view>

    <view
      class="list-item"
      wx:for="{{items}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpen"
      bindlongpress="onLongPress"
    >
      <view class="list-item-bar" style="background: {{item.color}};"></view>

      <view class="list-item-head">
        <text class="list-item-title">{{item.dateLabel}}</text>
        <text class="list-item-time">{{item.levelLabel}}</text>
      </view>

      <text class="list-item-sub" wx:if="{{item.note}}">{{item.note}}</text>

      <view class="list-item-meta" wx:if="{{item.tags.length > 0}}">
        <app-tag wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this" text="#{{t}}" />
      </view>
    </view>

    <app-empty
      wx:if="{{count === 0}}"
      text="还没有心情记录，点上面的圆点开始"
    />
  </view>

  <!-- ==================== 编辑面板 ==================== -->
  <view class="panel" wx:if="{{editing}}">
    <view class="panel-head">
      <text class="panel-title">编辑 {{formDate}}</text>
      <view class="panel-close" bindtap="onClosePanel">×</view>
    </view>

    <scroll-view scroll-y class="panel-body">
      <view class="field">
        <text class="field-label">心情</text>
        <view class="chips">
          <view
            class="chip {{item.active ? 'is-active' : ''}}"
            wx:for="{{formLevels}}"
            wx:key="level"
            data-level="{{item.level}}"
            bindtap="onFormLevel"
            style="{{item.active ? 'background:' + item.color + ';border-color:' + item.color + ';' : ''}}"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">标签（逗号或空格分隔）</text>
        <input class="input" value="{{formTags}}" placeholder="例如：work, code" placeholder-class="ph" bindinput="onFormTags" />
      </view>

      <view class="field">
        <text class="field-label">备注</text>
        <textarea class="textarea" value="{{formNote}}" placeholder="今天发生了什么" placeholder-class="ph" bindinput="onFormNote" />
      </view>

      <view class="actions">
        <view class="btn-ghost act" bindtap="onClosePanel">取消</view>
        <view class="btn-primary act" bindtap="onSave">保存</view>
      </view>

      <view class="btn-danger delete" bindtap="onDelete">删除这天的记录</view>
    </scroll-view>
  </view>
</view>
