/* 心情 */

/* ==================== 今日打卡 ==================== */

.today-card {
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 16rpx;
}

.today-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.today-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.today-state {
  font-size: 24rpx;
  color: var(--brand, #0284C7);
}

.today-dots {
  display: flex;
  justify-content: space-between;
}

.dot-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2.5rpx solid var(--border-strong);
  transition: transform 150ms ease;
}

.dot.is-active {
  transform: scale(1.08);
}

.dot-label {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--text-muted);
}

.dot-label.is-active {
  color: var(--text-primary);
  font-weight: 500;
}

/* ==================== 最近 14 天 ==================== */

.strip-card {
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 8rpx;
}

.strip-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.strip-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.strip-streak {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.strip {
  display: flex;
  gap: 8rpx;
}

.strip-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.strip-block {
  width: 100%;
  height: 48rpx;
  border-radius: 8rpx;
  background: var(--bg-tertiary);
}

.strip-block.is-today {
  border: 2rpx solid var(--text-primary);
}

.strip-day {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
}
