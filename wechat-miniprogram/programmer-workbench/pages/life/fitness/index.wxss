/* 健身 */

.week-card {
  display: flex;
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.week-cell {
  flex: 1;
  padding: 28rpx 8rpx;
  text-align: center;
  border-right: 0.5px solid var(--border);
}

.week-cell:last-child {
  border-right: none;
}

.week-value {
  display: block;
  font-size: 40rpx;
  font-weight: 500;
  color: var(--brand, #0284C7);
  line-height: 1.2;
}

.week-label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.picker-value {
  display: flex;
  align-items: center;
}
