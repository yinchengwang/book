<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <app-header title="健身" showBack />

  <view class="page-body">
    <!-- 本周汇总 -->
    <view class="week-card">
      <view class="week-cell">
        <text class="week-value num">{{weekCount}}</text>
        <text class="week-label">本周次数</text>
      </view>
      <view class="week-cell">
        <text class="week-value num">{{weekMinutes}}</text>
        <text class="week-label">分钟</text>
      </view>
      <view class="week-cell">
        <text class="week-value num">{{weekCalories}}</text>
        <text class="week-label">千卡</text>
      </view>
    </view>

    <view class="summary">
      <text class="summary-text">共 {{count}} 条记录</text>
    </view>

    <view
      class="list-item"
      wx:for="{{items}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpen"
      bindlongpress="onLongPress"
    >
      <view class="list-item-bar" style="background: var(--brand, #0284C7);"></view>

      <view class="list-item-head">
        <text class="list-item-title ellipsis">{{item.name}}</text>
        <text class="list-item-time">{{item.dateLabel}}</text>
      </view>

      <text class="list-item-sub ellipsis" wx:if="{{item.notes}}">{{item.notes}}</text>

      <view class="list-item-meta">
        <app-tag text="{{item.typeLabel}}" />
        <app-tag text="{{item.duration}}" />
        <app-tag wx:if="{{item.calories > 0}}" text="{{item.calories}} 千卡" />
      </view>
    </view>

    <app-empty
      wx:if="{{count === 0}}"
      text="还没有运动记录"
      actionText="记录一次"
      bind:action="onCreate"
    />

    <view class="bottom-space"></view>
  </view>

  <app-fab bind:tap="onCreate" />

  <!-- ==================== 编辑面板 ==================== -->
  <view class="panel" wx:if="{{editing}}">
    <view class="panel-head">
      <text class="panel-title">{{isEdit ? '编辑记录' : '记录运动'}}</text>
      <view class="panel-close" bindtap="onClosePanel">×</view>
    </view>

    <scroll-view scroll-y class="panel-body">
      <view class="field">
        <text class="field-label">日期</text>
        <picker mode="date" value="{{formDate}}" bindchange="onFormDate">
          <view class="input picker-value">{{formDate}}</view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">类型</text>
        <view class="chips">
          <view
            class="chip {{item.active ? 'is-active' : ''}}"
            wx:for="{{types}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onFormType"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">名称</text>
        <input class="input" value="{{formName}}" placeholder="例如：晨跑" placeholder-class="ph" bindinput="onFormName" />
      </view>

      <view class="two-col">
        <view class="field col">
          <text class="field-label">时长（分钟）</text>
          <input class="input num" type="number" value="{{formDuration}}" placeholder="30" placeholder-class="ph" bindinput="onFormDuration" />
        </view>
        <view class="field col">
          <text class="field-label">消耗（千卡）</text>
          <input class="input num" type="number" value="{{formCalories}}" placeholder="可选" placeholder-class="ph" bindinput="onFormCalories" />
        </view>
      </view>

      <view class="field">
        <text class="field-label">备注（可选）</text>
        <textarea class="textarea" value="{{formNotes}}" placeholder="今天的感受" placeholder-class="ph" bindinput="onFormNotes" />
      </view>

      <view class="actions">
        <view class="btn-ghost act" bindtap="onClosePanel">取消</view>
        <view class="btn-primary act" bindtap="onSave">保存</view>
      </view>

      <view class="btn-danger delete" wx:if="{{isEdit}}" bindtap="onDelete">删除这条记录</view>
    </scroll-view>
  </view>
</view>
