<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <app-header title="日程" showBack />

  <view class="page-body">
    <view class="summary">
      <text class="summary-text">{{count}} 条日程</text>
      <text class="summary-text" wx:if="{{todayCount > 0}}">· 今天 {{todayCount}} 项待办</text>
      <text class="summary-text" wx:if="{{openCount === 0 && count > 0}}">· 全部完成</text>
    </view>

    <view
      class="list-item {{item.done ? 'is-done' : ''}}"
      wx:for="{{items}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpen"
      bindlongpress="onLongPress"
    >
      <view class="list-item-bar" style="background: {{item.done ? 'var(--border-strong)' : 'var(--brand, #0284C7)'}};"></view>

      <view class="event-row">
        <view
          class="check {{item.done ? 'is-checked' : ''}}"
          data-id="{{item.id}}"
          catchtap="onToggleDone"
        ></view>

        <view class="event-main">
          <view class="list-item-head">
            <text class="list-item-title ellipsis {{item.done ? 'is-done-text' : ''}}">{{item.title}}</text>
            <text class="list-item-time">{{item.timeLabel}}</text>
          </view>
          <text class="list-item-sub" wx:if="{{item.location}}">{{item.location}}</text>
        </view>
      </view>

      <view class="list-item-meta">
        <app-tag text="{{item.dateLabel}}" color="{{item.isToday ? brand : ''}}" />
        <app-tag wx:if="{{item.reminder}}" text="提醒" />
      </view>
    </view>

    <app-empty
      wx:if="{{count === 0}}"
      text="还没有日程安排"
      actionText="添加日程"
      bind:action="onCreate"
    />

    <view class="bottom-space"></view>
  </view>

  <app-fab bind:tap="onCreate" />

  <!-- ==================== 编辑面板 ==================== -->
  <view class="panel" wx:if="{{editing}}">
    <view class="panel-head">
      <text class="panel-title">{{isEdit ? '编辑日程' : '添加日程'}}</text>
      <view class="panel-close" bindtap="onClosePanel">×</view>
    </view>

    <scroll-view scroll-y class="panel-body">
      <view class="field">
        <text class="field-label">标题</text>
        <input class="input" value="{{formTitle}}" placeholder="要做什么" placeholder-class="ph" bindinput="onFormTitle" />
      </view>

      <view class="two-col">
        <view class="field col">
          <text class="field-label">日期</text>
          <picker mode="date" value="{{formDate}}" bindchange="onFormDate">
            <view class="input picker-value">{{formDate}}</view>
          </picker>
        </view>
        <view class="field col">
          <text class="field-label">时间</text>
          <picker mode="time" value="{{formTime}}" bindchange="onFormTime">
            <view class="input picker-value num">{{formTime}}</view>
          </picker>
        </view>
      </view>

      <view class="field">
        <text class="field-label">地点（可选）</text>
        <input class="input" value="{{formLocation}}" placeholder="例如：线上会议" placeholder-class="ph" bindinput="onFormLocation" />
      </view>

      <view class="field">
        <text class="field-label">备注（可选）</text>
        <textarea class="textarea" value="{{formNote}}" placeholder="补充说明" placeholder-class="ph" bindinput="onFormNote" />
      </view>

      <view class="field">
        <view class="editor-head">
          <text class="field-label">提醒</text>
          <text class="toggle" bindtap="onToggleReminder">{{formReminder ? '已开启' : '已关闭'}}</text>
        </view>
      </view>

      <view class="actions">
        <view class="btn-ghost act" bindtap="onClosePanel">取消</view>
        <view class="btn-primary act" bindtap="onSave">保存</view>
      </view>

      <view class="btn-danger delete" wx:if="{{isEdit}}" bindtap="onDelete">删除这条日程</view>
    </scroll-view>
  </view>
</view>
