/* 日程 */

.event-row {
  display: flex;
  align-items: flex-start;
}

/* 完成勾选圆 */
.check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2.5rpx solid var(--border-strong);
  flex-shrink: 0;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check.is-checked {
  background: var(--brand, #0284C7);
  border-color: var(--brand, #0284C7);
}

.check.is-checked::after {
  content: '';
  width: 8rpx;
  height: 14rpx;
  border-right: 3rpx solid #FFFFFF;
  border-bottom: 3rpx solid #FFFFFF;
  transform: rotate(45deg) translate(-1rpx, -1rpx);
}

.event-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.is-done-text {
  color: var(--text-muted);
  text-decoration: line-through;
}

.picker-value {
  display: flex;
  align-items: center;
}
