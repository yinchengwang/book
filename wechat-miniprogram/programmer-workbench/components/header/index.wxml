<view class="header">
  <view class="side" bindtap="onBack" wx:if="{{showBack}}">
    <view class="back-icon">
      <view class="chevron"></view>
    </view>
  </view>
  <view class="side" wx:else></view>

  <text class="title ellipsis">{{title}}</text>

  <view class="side right" bindtap="onRight">
    <text class="right-text" wx:if="{{rightText}}">{{rightText}}</text>
    <slot name="right"></slot>
  </view>
</view>
