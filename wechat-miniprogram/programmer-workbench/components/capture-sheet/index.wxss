/* capture-sheet —— 底部捕获浮层 */

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 200;
}

.sheet {
  width: 100%;
  background: var(--bg-secondary);
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx 48rpx;
  /* 适配全面屏底部安全区 */
  padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.grip {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--border-strong);
  margin: 8rpx auto 24rpx;
}

.sheet-title {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.sheet-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.action {
  flex: 1;
  background: var(--bg-tertiary);
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action:active {
  opacity: 0.75;
}

.action-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--bg-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.action-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.action-desc {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text-muted);
  text-align: center;
}

.cancel {
  margin-top: 24rpx;
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  background: var(--bg-tertiary);
}

/* ==================== 图标（纯 CSS） ==================== */

.ico-check {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2.5rpx solid var(--brand, #0284C7);
}

.ico-plus {
  position: relative;
  width: 34rpx;
  height: 34rpx;
}

.ico-plus .bar-h {
  position: absolute;
  top: 16rpx;
  left: 0;
  width: 34rpx;
  height: 2.5rpx;
  background: var(--brand, #0284C7);
  border-radius: 2rpx;
}

.ico-plus .bar-v {
  position: absolute;
  left: 16rpx;
  top: 0;
  width: 2.5rpx;
  height: 34rpx;
  background: var(--brand, #0284C7);
  border-radius: 2rpx;
}

.ico-doc {
  width: 28rpx;
  height: 34rpx;
  border: 2.5rpx solid var(--brand, #0284C7);
  border-radius: 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
}

.ico-doc .line {
  width: 14rpx;
  height: 2.5rpx;
  background: var(--brand, #0284C7);
  border-radius: 2rpx;
}

.ico-doc .line.short {
  width: 9rpx;
  margin-right: 5rpx;
}
