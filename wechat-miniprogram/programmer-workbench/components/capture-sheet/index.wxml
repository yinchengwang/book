<view class="mask" wx:if="{{visible}}" bindtap="onClose">
  <view class="sheet" catchtap="noop">
    <view class="grip"></view>
    <text class="sheet-title">记一笔</text>
    <text class="sheet-sub">不用想归属，先记下来</text>

    <view class="actions">
      <view class="action" data-type="todo" bindtap="onPick">
        <view class="action-icon">
          <view class="ico-check"></view>
        </view>
        <text class="action-label">待办</text>
        <text class="action-desc">今天要做的事</text>
      </view>

      <view class="action" data-type="insight" bindtap="onPick">
        <view class="action-icon">
          <view class="ico-plus">
            <view class="bar-h"></view>
            <view class="bar-v"></view>
          </view>
        </view>
        <text class="action-label">闪念</text>
        <text class="action-desc">一闪而过的想法</text>
      </view>

      <view class="action" data-type="note" bindtap="onPick">
        <view class="action-icon">
          <view class="ico-doc">
            <view class="line"></view>
            <view class="line short"></view>
          </view>
        </view>
        <text class="action-label">笔记</text>
        <text class="action-desc">Markdown 长文</text>
      </view>
    </view>

    <view class="cancel" bindtap="onClose">取消</view>
  </view>
</view>
