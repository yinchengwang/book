<view class="page">
  <!-- 记分板 -->
  <view class="scoreboard">
    <view class="score-box">
      <view class="score-label">当前</view>
      <view class="score-value">{{score}}</view>
    </view>
    <view class="score-box">
      <view class="score-label">最高</view>
      <view class="score-value">{{best}}</view>
    </view>
  </view>

  <!-- 棋盘 -->
  <view
    class="board-wrap"
    bindtouchstart="onTouchStart"
    bindtouchend="onTouchEnd"
  >
    <canvas
      type="2d"
      id="snake-canvas"
      class="board"
    ></canvas>

    <!-- 遮罩层：准备 / 暂停 / 结束 -->
    <view class="overlay" wx:if="{{status !== 'playing'}}">
      <view class="overlay-title">
        {{status === 'ready' ? '准备好了吗' : status === 'paused' ? '已暂停' : '游戏结束'}}
      </view>
      <view class="overlay-sub" wx:if="{{status === 'over'}}">
        本局得分 {{score}}
      </view>
      <button
        class="btn-primary overlay-btn"
        bindtap="{{status === 'paused' ? 'onResume' : 'onStart'}}"
      >
        {{status === 'paused' ? '继续游戏' : status === 'over' ? '再来一局' : '开始游戏'}}
      </button>
    </view>
  </view>

  <!-- 方向按钮 -->
  <view class="dpad">
    <view class="dpad-btn dpad-up" data-dir="up" bindtap="onDirection">↑</view>
    <view class="dpad-btn dpad-left" data-dir="left" bindtap="onDirection">←</view>
    <view class="dpad-center"></view>
    <view class="dpad-btn dpad-right" data-dir="right" bindtap="onDirection">→</view>
    <view class="dpad-btn dpad-down" data-dir="down" bindtap="onDirection">↓</view>
  </view>

  <view class="hint">在棋盘上滑动也可控制方向</view>

  <!-- 暂停按钮 -->
  <view
    class="pause-btn"
 wx:if="{{status === 'playing'}}"
    bindtap="onPause"
  >暂停</view>

  <!-- 成就弹窗 -->
  <view class="achv-toast" wx:if="{{achievementToast}}">
    <view class="achv-toast-emoji">{{achievementToast.emoji}}</view>
    <view class="achv-toast-name">{{achievementToast.name}}</view>
  </view>
</view>