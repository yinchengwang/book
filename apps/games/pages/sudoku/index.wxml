<view class="page">
  <!-- ============ 阶段一：章节选择 ============ -->
  <block wx:if="{{phase === 'menu'}}">
    <view class="menu-head">
      <view class="menu-title">数独</view>
      <view class="menu-sub">5 大章节 · 每章 10 关 · 逻辑推理</view>
    </view>

    <view
      class="chapter {{item.unlocked ? '' : 'is-locked'}}"
      wx:for="{{chapters}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onChapterTap"
    >
      <view class="chapter-head">
        <text class="chapter-name">第 {{item.id}} 章 {{item.unlocked ? '' : '🔒'}}</text>
        <text class="chapter-stars">{{item.totalStars}} / {{item.maxStars}} ⭐</text>
      </view>

      <view class="level-row">
        <view
          class="level {{level.unlocked ? '' : 'is-locked'}}"
          wx:for="{{item.levels}}"
          wx:for-item="level"
          wx:key="id"
          data-level="{{level.id}}"
          data-unlocked="{{level.unlocked}}"
          bindtap="onLevelTap"
        >
          <text class="level-id">{{level.id}}</text>
          <view class="level-stars">
            <text
              class="star {{s <= level.stars ? 'is-on' : ''}}"
              wx:for="{{[1,2,3]}}"
              wx:for-item="s"
              wx:key="*this"
            >★</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ============ 阶段二：游戏 ============ -->
  <block wx:else>
    <!-- 状态栏 -->
    <view class="statusbar">
      <view class="stat">
        <text class="stat-label">关卡</text>
        <text class="stat-value">{{currentChapter}}-{{currentLevel}}</text>
      </view>
      <view class="stat">
        <text class="stat-label">剩余</text>
        <text class="stat-value">{{emptyCount}}</text>
      </view>
      <view class="stat">
        <text class="stat-label">提示</text>
        <text class="stat-value">{{hintCount}}</text>
      </view>
      <view class="stat">
        <text class="stat-label">难度</text>
        <text class="stat-value">{{difficultyName}}</text>
      </view>
    </view>

    <!-- 9x9 棋盘：81 格等宽栅格 -->
    <view class="board">
      <view
        class="cell {{item.hasRight ? 'has-right' : ''}} {{item.hasBottom ? 'has-bottom' : ''}} {{item.isGiven ? 'is-given' : ''}} {{item.isConflict ? 'is-conflict' : ''}} {{cursorRow === item.row && cursorCol === item.col ? 'is-cursor' : ''}}"
        wx:for="{{cells}}"
        wx:key="row"
      >
        <text
          class="cell-text"
          data-row="{{item.row}}"
          data-col="{{item.col}}"
          bindtap="onCellTap"
        >{{item.value === 0 ? '' : item.value}}</text>
      </view>
    </view>

    <!-- 光标移动 -->
    <view class="toolbar">
      <view class="tool-btn" bindtap="onMoveCursor" data-dx="-1" data-dy="0">←</view>
      <view class="tool-btn" bindtap="onMoveCursor" data-dx="0" data-dy="-1">↑</view>
      <view class="tool-btn" bindtap="onMoveCursor" data-dx="0" data-dy="1">↓</view>
      <view class="tool-btn" bindtap="onMoveCursor" data-dx="1" data-dy="0">→</view>
    </view>

    <!-- 数字键盘 -->
    <view class="numpad">
      <view
        class="num {{selectedNumber === n ? 'is-active' : ''}}"
        wx:for="{{[1,2,3,4,5,6,7,8,9]}}"
        wx:for-item="n"
        wx:key="*this"
        data-num="{{n}}"
        bindtap="onNumberTap"
      >{{n}}</view>
      <view class="num num-action" bindtap="onErase">擦除</view>
      <view class="num num-action num-hint" bindtap="onHint">提示</view>
    </view>

    <view class="back-btn" bindtap="onBack">返回章节</view>

    <!-- 通关弹窗 -->
    <view class="overlay" wx:if="{{status === 'won'}}">
      <view class="overlay-title">🎉 通关！</view>
      <view class="overlay-sub">第 {{currentChapter}} 章第 {{currentLevel}} 关</view>
      <view class="overlay-stars">
        <text
          class="star-lg is-on"
          wx:for="{{[1,2,3]}}"
          wx:for-item="s"
          wx:key="*this"
        >★</text>
      </view>
      <button class="btn-primary overlay-btn" bindtap="onBack">返回章节</button>
    </view>
  </block>

  <!-- 成就弹窗 -->
  <view class="achv-toast" wx:if="{{achievementToast}}">
    <view class="achv-toast-emoji">{{achievementToast.emoji}}</view>
    <view class="achv-toast-name">{{achievementToast.name}}</view>
  </view>
</view>