.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 64rpx;
}

/* 头部 */
.hero {
  padding: 32rpx 8rpx 48rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #718096;
}

/* 游戏卡片 */
.game-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.game-card {
  display: flex;
  align-items: center;
  background: #1a1a2e;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.25);
}

.game-card:active {
  background: #22223d;
}

.game-emoji {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  flex-shrink: 0;
}

.game-body {
  flex: 1;
  margin-left: 28rpx;
}

.game-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.game-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #718096;
}

.game-stat {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #667eea;
  font-weight: 500;
}

.game-arrow {
  font-size: 44rpx;
  color: #4a5568;
  padding-left: 16rpx;
}

/* 区块 */
.section {
  margin-top: 56rpx;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 8rpx 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.section-meta {
  font-size: 24rpx;
  color: #718096;
}

/* 成就列表 */
.achv-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.achv-item {
  display: flex;
  align-items: center;
  background: #1a1a2e;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  border-left: 6rpx solid #2d3748;
}

.achv-item.is-unlocked {
  border-left-color: #667eea;
  background: #1f2340;
}

.achv-emoji {
  font-size: 44rpx;
  margin-right: 24rpx;
}

.achv-item.is-locked .achv-emoji {
  opacity: 0.3;
}

.achv-info {
  flex: 1;
}

.achv-name {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.achv-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #718096;
}

.achv-state {
  font-size: 22rpx;
  color: #4a5568;
}

.achv-item.is-unlocked .achv-state {
  color: #667eea;
}

.reset-btn {
  width: 100%;
  text-align: center;
}