<view class="page">
  <!-- 头部概览 -->
  <view class="hero">
    <view class="hero-title">游戏中心</view>
    <view class="hero-sub">四款经典小游戏 · 全部离线可玩</view>
  </view>

  <!-- 游戏列表 -->
  <view class="game-grid">
    <view
      class="game-card"
      wx:for="{{games}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onGameTap"
    >
      <view class="game-emoji" style="background: {{item.color}}">{{item.emoji}}</view>
      <view class="game-body">
        <view class="game-title">{{item.title}}</view>
        <view class="game-desc">{{item.desc}}</view>
        <view class="game-stat">{{item.stat}}</view>
      </view>
      <view class="game-arrow">›</view>
    </view>
  </view>

  <!-- 成就墙 -->
  <view class="section">
    <view class="section-header" bindtap="onToggleAchievements">
      <text class="section-title">成就墙</text>
      <text class="section-meta">
        {{achievementUnlocked}} / {{achievementTotal}}
        {{achievements.length > 0 ? '收起 ▴' : '展开 ▾'}}
      </text>
    </view>

    <view class="achv-list" wx:if="{{achievements.length > 0}}">
      <view
        class="achv-item {{item.unlocked ? 'is-unlocked' : 'is-locked'}}"
        wx:for="{{achievements}}"
        wx:key="id"
      >
        <view class="achv-emoji">{{item.emoji}}</view>
        <view class="achv-info">
          <view class="achv-name">{{item.name}}</view>
          <view class="achv-desc">{{item.desc}}</view>
        </view>
        <view class="achv-state">{{item.unlocked ? '已解锁' : '未解锁'}}</view>
      </view>
    </view>
  </view>

  <!-- 数据管理 -->
  <view class="section">
    <view class="btn-ghost reset-btn" bindtap="onResetConfirm">清空全部游戏数据</view>
  </view>
</view>