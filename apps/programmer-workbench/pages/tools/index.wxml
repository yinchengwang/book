<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">

  <view class="page-body">
    <view class="page-head">
      <text class="t-display">工具箱</text>
      <text class="page-sub">离线即用 · 无需上传 · 结果即时</text>
    </view>

    <!-- 搜索 -->
    <view class="search">
      <view class="search-icon">
        <view class="glass"></view>
        <view class="handle"></view>
      </view>
      <input
        class="search-input"
        value="{{query}}"
        placeholder="搜索工具"
        placeholder-class="ph"
        bindinput="onSearch"
      />
      <view class="search-clear" wx:if="{{query}}" bindtap="onClearSearch">×</view>
    </view>

    <!-- 工具网格 -->
    <view class="grid">
      <view
        class="tool"
        wx:for="{{filtered}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onOpen"
      >
        <view class="tool-icon">{{item.symbol}}</view>
        <text class="tool-label">{{item.label}}</text>
      </view>
    </view>

    <view class="empty" wx:if="{{filtered.length === 0}}">
      <text class="t-caption">没有匹配的工具</text>
    </view>
  </view>

  <!-- ==================== 全屏工具面板 ==================== -->
  <view class="panel" wx:if="{{active}}">
    <view class="panel-head">
      <view class="panel-symbol">{{activeSymbol}}</view>
      <text class="panel-title">{{activeLabel}}</text>
      <view class="panel-close" bindtap="onClose">×</view>
    </view>

    <scroll-view scroll-y class="panel-body">

      <!-- ---------- JSON ---------- -->
      <block wx:if="{{active === 'json'}}">
        <view class="chips">
          <view
            class="chip {{jsonMode === item.key ? 'is-active' : ''}}"
            wx:for="{{jsonModes}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onJsonMode"
          >{{item.label}}</view>
        </view>
        <view class="field">
          <view class="field-label">输入 JSON</view>
          <textarea class="textarea mono" value="{{input}}" bindinput="onInput" placeholder='{"a":1}' placeholder-class="ph" />
        </view>
        <view class="err" wx:if="{{error}}">{{error}}</view>
        <block wx:if="{{output}}">
          <view class="out-head">
            <text class="field-label">结果</text>
            <text class="copy" bindtap="onCopy">复制</text>
          </view>
          <view class="code-block">{{output}}</view>
        </block>
      </block>

      <!-- ---------- Base64 ---------- -->
      <block wx:if="{{active === 'base64'}}">
        <view class="chips">
          <view
            class="chip {{base64Mode === item.key ? 'is-active' : ''}}"
            wx:for="{{base64Modes}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onBase64Mode"
          >{{item.label}}</view>
        </view>
        <view class="field">
          <view class="field-label">{{base64Mode === 'encode' ? '原文' : 'Base64 文本'}}</view>
          <textarea class="textarea mono" value="{{input}}" bindinput="onInput" placeholder="输入内容" placeholder-class="ph" />
        </view>
        <view class="err" wx:if="{{error}}">{{error}}</view>
        <block wx:if="{{output}}">
          <view class="out-head">
            <text class="field-label">结果</text>
            <text class="copy" bindtap="onCopy">复制</text>
          </view>
          <view class="code-block">{{output}}</view>
        </block>
      </block>

      <!-- ---------- URL ---------- -->
      <block wx:if="{{active === 'url'}}">
        <view class="chips">
          <view
            class="chip {{urlMode === item.key ? 'is-active' : ''}}"
            wx:for="{{urlModes}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onUrlMode"
          >{{item.label}}</view>
        </view>
        <view class="field">
          <view class="field-label">输入</view>
          <textarea class="textarea mono" value="{{input}}" bindinput="onInput" placeholder="a=1&amp;b=中文" placeholder-class="ph" />
        </view>
        <view class="err" wx:if="{{error}}">{{error}}</view>
        <block wx:if="{{output}}">
          <view class="out-head">
            <text class="field-label">结果</text>
            <text class="copy" bindtap="onCopy">复制</text>
          </view>
          <view class="code-block">{{output}}</view>
        </block>
      </block>

      <!-- ---------- 时间戳 ---------- -->
      <block wx:if="{{active === 'timestamp'}}">
        <view class="now-card">
          <view class="now-row">
            <text class="now-label">当前毫秒</text>
            <text class="now-value num">{{tsNowMs}}</text>
            <text class="copy" data-text="{{tsNowMs}}" bindtap="onCopy">复制</text>
          </view>
          <view class="divider"></view>
          <view class="now-row">
            <text class="now-label">当前秒</text>
            <text class="now-value num">{{tsNowS}}</text>
            <text class="copy" data-text="{{tsNowS}}" bindtap="onCopy">复制</text>
          </view>
        </view>

        <view class="field">
          <view class="out-head">
            <text class="field-label">时间戳 或 日期字符串</text>
            <text class="copy" bindtap="onUseNow">用当前时间</text>
          </view>
          <input class="input mono" value="{{input}}" bindinput="onInput" placeholder="1700000000000 或 2026-10-22 09:00:00" placeholder-class="ph" />
        </view>

        <view class="err" wx:if="{{error}}">{{error}}</view>

        <block wx:if="{{tsDate}}">
          <view class="kv">
            <text class="kv-k">日期时间</text>
            <text class="kv-v num">{{tsDate}}</text>
            <text class="copy" data-text="{{tsDate}}" bindtap="onCopy">复制</text>
          </view>
          <view class="kv">
            <text class="kv-k">毫秒</text>
            <text class="kv-v num">{{tsMs}}</text>
            <text class="copy" data-text="{{tsMs}}" bindtap="onCopy">复制</text>
          </view>
          <view class="kv">
            <text class="kv-k">秒</text>
            <text class="kv-v num">{{tsS}}</text>
            <text class="copy" data-text="{{tsS}}" bindtap="onCopy">复制</text>
          </view>
        </block>
      </block>

      <!-- ---------- UUID ---------- -->
      <block wx:if="{{active === 'uuid'}}">
        <view class="chips">
          <view
            class="chip {{uuidCount === item ? 'is-active' : ''}}"
            wx:for="{{uuidCounts}}"
            wx:key="*this"
            data-count="{{item}}"
            bindtap="onUuidCount"
          >{{item}} 个</view>
        </view>
        <view class="out-head">
          <text class="field-label">生成结果</text>
          <text class="copy" bindtap="onCopy">复制全部</text>
        </view>
        <view class="uuid-list">
          <view class="uuid-row" wx:for="{{uuidList}}" wx:key="*this">
            <text class="uuid-text mono">{{item}}</text>
            <text class="copy" data-text="{{item}}" bindtap="onCopy">复制</text>
          </view>
        </view>
      </block>

      <!-- ---------- 正则 ---------- -->
      <block wx:if="{{active === 'regex'}}">
        <view class="field">
          <view class="field-label">正则表达式</view>
          <input class="input mono" value="{{input}}" bindinput="onInput" placeholder="\d+" placeholder-class="ph" />
        </view>

        <view class="field">
          <view class="field-label">修饰符</view>
          <view class="chips">
            <view
              class="chip {{regexFlags.indexOf(item) >= 0 ? 'is-active' : ''}}"
              wx:for="{{flagOptions}}"
              wx:key="*this"
              data-flag="{{item}}"
              bindtap="onToggleFlag"
            >{{item}}</view>
          </view>
        </view>

        <view class="field">
          <view class="field-label">测试文本</view>
          <textarea class="textarea mono" value="{{inputB}}" bindinput="onInputB" placeholder="粘贴待匹配文本" placeholder-class="ph" />
        </view>

        <view class="err" wx:if="{{error}}">{{error}}</view>

        <block wx:if="{{regexSegments.length > 0}}">
          <view class="out-head">
            <text class="field-label">命中 {{regexCount}} 处</text>
          </view>
          <view class="hl">
            <text
              class="hl-seg {{item.hit ? 'is-hit' : ''}}"
              wx:for="{{regexSegments}}"
              wx:key="index"
            >{{item.value}}</text>
          </view>
        </block>
      </block>

      <!-- ---------- 颜色 ---------- -->
      <block wx:if="{{active === 'color'}}">
        <view class="field">
          <view class="field-label">HEX 或 RGB</view>
          <input class="input mono" value="{{input}}" bindinput="onInput" placeholder="#0284C7 或 rgb(2, 132, 199)" placeholder-class="ph" />
        </view>

        <view class="err" wx:if="{{error}}">{{error}}</view>

        <block wx:if="{{colorHex}}">
          <view class="swatch" style="background: {{colorSwatch}};"></view>
          <view class="kv">
            <text class="kv-k">HEX</text>
            <text class="kv-v mono">{{colorHex}}</text>
            <text class="copy" data-text="{{colorHex}}" bindtap="onCopy">复制</text>
          </view>
          <view class="kv">
            <text class="kv-k">RGB</text>
            <text class="kv-v mono">{{colorRgb}}</text>
            <text class="copy" data-text="{{colorRgb}}" bindtap="onCopy">复制</text>
          </view>
          <view class="kv">
            <text class="kv-k">RGBA</text>
            <text class="kv-v mono">{{colorRgba}}</text>
            <text class="copy" data-text="{{colorRgba}}" bindtap="onCopy">复制</text>
          </view>
        </block>
      </block>

      <!-- ---------- Hash ---------- -->
      <block wx:if="{{active === 'hash'}}">
        <view class="field">
          <view class="field-label">输入文本</view>
          <textarea class="textarea mono" value="{{input}}" bindinput="onInput" placeholder="输入任意文本" placeholder-class="ph" />
        </view>
        <block wx:if="{{hashDjb2}}">
          <view class="kv">
            <text class="kv-k">djb2</text>
            <text class="kv-v mono">{{hashDjb2}}</text>
            <text class="copy" data-text="{{hashDjb2}}" bindtap="onCopy">复制</text>
          </view>
          <view class="kv">
            <text class="kv-k">CRC32</text>
            <text class="kv-v mono">{{hashCrc32}}</text>
            <text class="copy" data-text="{{hashCrc32}}" bindtap="onCopy">复制</text>
          </view>
        </block>
      </block>

      <!-- ---------- Diff ---------- -->
      <block wx:if="{{active === 'diff'}}">
        <view class="field">
          <view class="field-label">原文 A</view>
          <textarea class="textarea mono" value="{{input}}" bindinput="onInput" placeholder="旧文本" placeholder-class="ph" />
        </view>
        <view class="field">
          <view class="field-label">对照 B</view>
          <textarea class="textarea mono" value="{{inputB}}" bindinput="onInputB" placeholder="新文本" placeholder-class="ph" />
        </view>

        <view class="err" wx:if="{{error}}">{{error}}</view>

        <block wx:if="{{diffOps.length > 0}}">
          <view class="out-head">
            <text class="field-label">{{diffNote}}</text>
            <text class="copy" bindtap="onCopy">复制</text>
          </view>
          <view class="diff">
            <text
              class="diff-seg {{item.type === 'add' ? 'is-add' : item.type === 'del' ? 'is-del' : ''}}"
              wx:for="{{diffOps}}"
              wx:key="index"
            >{{item.text}}</text>
          </view>
        </block>
        <view class="note" wx:if="{{diffNote && diffOps.length === 0}}">{{diffNote}}</view>
      </block>

      <!-- ---------- Cron ---------- -->
      <block wx:if="{{active === 'cron'}}">
        <view class="field">
          <view class="field-label">表达式（分 时 日 月 周）</view>
          <input class="input mono" value="{{input}}" bindinput="onInput" placeholder="0 9 * * *" placeholder-class="ph" />
        </view>

        <view class="err" wx:if="{{cronError}}">{{cronError}}</view>

        <block wx:if="{{cronNext.length > 0}}">
          <view class="out-head">
            <text class="field-label">接下来 5 次触发</text>
            <text class="copy" bindtap="onCopy">复制</text>
          </view>
          <view class="kv" wx:for="{{cronNext}}" wx:key="*this">
            <text class="kv-v num">{{item}}</text>
          </view>
        </block>

        <view class="note">支持 * , - / 语法，例如 0 9 * * 1-5、*/5 * * * *</view>
      </block>

    </scroll-view>
  </view>
</view>
