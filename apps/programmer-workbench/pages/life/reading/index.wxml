<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <app-header title="读书" showBack />

  <view class="page-body">
    <view class="summary">
      <text class="summary-text">{{count}} 本</text>
      <text class="summary-text" wx:if="{{readingCount > 0}}">· 在读 {{readingCount}}</text>
      <text class="summary-text" wx:if="{{finishedCount > 0}}">· 已读 {{finishedCount}}</text>
    </view>

    <view
      class="list-item"
      wx:for="{{items}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpen"
    >
      <view class="list-item-bar" style="background: {{item.color}};"></view>

      <view class="list-item-head">
        <text class="list-item-title ellipsis">{{item.title}}</text>
        <text class="list-item-time">{{item.statusLabel}}</text>
      </view>

      <text class="list-item-sub ellipsis" wx:if="{{item.author}}">{{item.author}}</text>

      <view class="progress-row">
        <app-progress-bar percent="{{item.percent}}" color="{{item.color}}" height="{{8}}" />
        <text class="progress-text num">{{item.progressText}}</text>
      </view>

      <view class="list-item-meta" wx:if="{{item.rating > 0}}">
        <view class="rating">
          <view
            class="rating-dot {{s <= item.rating ? 'is-on' : ''}}"
            wx:for="{{[1,2,3,4,5]}}"
            wx:for-item="s"
            wx:key="*this"
          ></view>
        </view>
      </view>
    </view>

    <app-empty
      wx:if="{{count === 0}}"
      text="书架还是空的"
      actionText="添加一本书"
      bind:action="onCreate"
    />

    <view class="bottom-space"></view>
  </view>

  <app-fab bind:tap="onCreate" />

  <!-- ==================== 编辑面板 ==================== -->
  <view class="panel" wx:if="{{editing}}">
    <view class="panel-head">
      <text class="panel-title">{{isEdit ? '编辑' : '添加书籍'}}</text>
      <view class="panel-close" bindtap="onClosePanel">×</view>
    </view>

    <scroll-view scroll-y class="panel-body">
      <view class="field">
        <text class="field-label">书名</text>
        <input class="input" value="{{formTitle}}" placeholder="书名" placeholder-class="ph" bindinput="onFormTitle" />
      </view>

      <view class="field">
        <text class="field-label">作者（可选）</text>
        <input class="input" value="{{formAuthor}}" placeholder="作者" placeholder-class="ph" bindinput="onFormAuthor" />
      </view>

      <view class="two-col">
        <view class="field col">
          <text class="field-label">总页数</text>
          <input class="input num" type="number" value="{{formTotal}}" placeholder="0" placeholder-class="ph" bindinput="onFormTotal" />
        </view>
        <view class="field col">
          <text class="field-label">当前页</text>
          <input class="input num" type="number" value="{{formCurrent}}" placeholder="0" placeholder-class="ph" bindinput="onFormCurrent" />
        </view>
      </view>

      <view class="field">
        <text class="field-label">状态</text>
        <view class="chips">
          <view
            class="chip {{item.active ? 'is-active' : ''}}"
            wx:for="{{statuses}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onFormStatus"
            style="{{item.active ? 'background:' + item.color + ';border-color:' + item.color + ';' : ''}}"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">评分</text>
        <view class="rating-picker">
          <view
            class="rating-pick {{s <= formRating ? 'is-on' : ''}}"
            wx:for="{{ratingOptions}}"
            wx:for-item="s"
            wx:key="*this"
            data-star="{{s}}"
            bindtap="onFormRating"
          ></view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">读书笔记（可选）</text>
        <textarea class="textarea" value="{{formNotes}}" placeholder="记下想法" placeholder-class="ph" bindinput="onFormNotes" />
      </view>

      <view class="actions">
        <view class="btn-ghost act" bindtap="onClosePanel">取消</view>
        <view class="btn-primary act" bindtap="onSave">保存</view>
      </view>

      <view class="btn-danger delete" wx:if="{{isEdit}}" bindtap="onDelete">删除这本书</view>
    </scroll-view>
  </view>
</view>
