<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <view class="page-body">

    <view class="page-head">
      <text class="page-title">生活</text>
      <text class="page-sub">读书 · 健身 · 心情 · 日程</text>
    </view>

    <view
      class="entry"
      wx:for="{{entries}}"
      wx:key="key"
      data-path="{{item.path}}"
      bindtap="onOpen"
    >
      <view class="entry-symbol">{{item.symbol}}</view>
      <view class="entry-main">
        <view class="entry-head">
          <text class="entry-title">{{item.title}}</text>
          <text class="entry-count num">{{item.count}}</text>
        </view>
        <text class="entry-desc">{{item.desc}}</text>
      </view>
      <view class="entry-arrow"></view>
    </view>

  </view>

  <app-fab bottom="{{140}}" bind:tap="onOpenCapture" />
  <capture-sheet
    visible="{{captureVisible}}"
    bind:close="onCloseCapture"
    bind:created="onCaptured"
  />
</view>
