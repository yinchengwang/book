<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <app-header
    title="{{isEdit ? '编辑片段' : '新建片段'}}"
    showBack
    rightText="保存"
    bind:right="onSave"
  />

  <view class="page-body">
    <input
      class="title-input"
      value="{{formTitle}}"
      placeholder="片段标题"
      placeholder-class="ph"
      bindinput="onTitle"
    />

    <view class="field">
      <text class="field-label">语言</text>
      <view class="chips">
        <view
          class="chip {{item.active ? 'is-active' : ''}}"
          wx:for="{{languages}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onLanguage"
          style="{{item.active ? 'background:' + item.color + ';border-color:' + item.color + ';' : ''}}"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="field">
      <text class="field-label">说明</text>
      <input
        class="input"
        value="{{description}}"
        placeholder="一句话说明用途"
        placeholder-class="ph"
        bindinput="onDescription"
      />
    </view>

    <view class="field">
      <view class="editor-head">
        <text class="field-label">代码 · {{lineCount}} 行</text>
        <view class="head-actions">
          <text class="toggle" bindtap="onToggleFavorite">{{favorite ? '已收藏' : '收藏'}}</text>
          <text class="toggle" bindtap="onCopyCode">复制</text>
        </view>
      </view>
      <textarea
        class="textarea mono code-area"
        value="{{code}}"
        placeholder="粘贴代码"
        placeholder-class="ph"
        bindinput="onCode"
        auto-height
      />
    </view>

    <view class="field">
      <text class="field-label">标签（逗号或空格分隔）</text>
      <input
        class="input"
        value="{{tagsText}}"
        placeholder="例如：utility, fn"
        placeholder-class="ph"
        bindinput="onTags"
      />
    </view>

    <view class="actions">
      <view class="btn-ghost act" bindtap="onCopyCode">复制代码</view>
      <view class="btn-primary act" bindtap="onSave">保存</view>
    </view>

    <view class="btn-danger delete" wx:if="{{isEdit}}" bindtap="onDelete">删除这个片段</view>
  </view>
</view>
