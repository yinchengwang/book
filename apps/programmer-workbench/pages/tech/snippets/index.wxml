<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <app-header title="代码片段" showBack />

  <view class="page-body">
    <view class="summary">
      <text class="summary-text">{{count}} 个片段</text>
      <text class="summary-text" wx:if="{{favoriteCount > 0}}">· {{favoriteCount}} 个收藏</text>
    </view>

    <view
      class="list-item"
      wx:for="{{items}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpen"
      bindlongpress="onLongPress"
    >
      <view class="list-item-bar" style="background: {{item.color}};"></view>

      <view class="list-item-head">
        <text class="list-item-title ellipsis">{{item.title}}</text>
        <text class="list-item-time">{{item.time}}</text>
      </view>

      <text class="list-item-sub ellipsis" wx:if="{{item.desc}}">{{item.desc}}</text>

      <view class="list-item-meta">
        <text class="fav" wx:if="{{item.favorite}}">收藏</text>
        <app-tag text="{{item.languageLabel}}" color="{{item.color}}" />
        <app-tag text="{{item.lineCount}} 行" />
        <app-tag wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this" text="#{{t}}" />
      </view>
    </view>

    <app-empty
      wx:if="{{count === 0}}"
      text="还没有代码片段"
      actionText="新建片段"
      bind:action="onCreate"
    />

    <view class="bottom-space"></view>
  </view>

  <app-fab bind:tap="onCreate" />
</view>
