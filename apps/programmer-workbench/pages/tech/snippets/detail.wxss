.title-input {
  width: 100%;
  height: 96rpx;
  font-size: 38rpx;
  font-weight: 500;
  color: var(--text-primary);
  border-bottom: 0.5px solid var(--border);
  margin-bottom: 32rpx;
}

.head-actions {
  display: flex;
  gap: 24rpx;
}

.code-area {
  min-height: 400rpx;
  font-size: 26rpx;
  line-height: 1.65;
  background: var(--code-bg);
}

.delete {
  margin-top: 32rpx;
  width: 100%;
}
