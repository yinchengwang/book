/* 技术笔记 · 列表 */

.summary {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 8rpx 20rpx;
}

.summary-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.pin {
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: var(--brand-soft, rgba(2, 132, 199, 0.12));
  color: var(--brand, #0284C7);
  font-size: 20rpx;
  display: flex;
  align-items: center;
}

.bottom-space {
  height: 160rpx;
}
