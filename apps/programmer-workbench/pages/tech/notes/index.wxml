<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <app-header title="技术笔记" showBack />

  <view class="page-body">
    <view class="summary">
      <text class="summary-text">{{count}} 篇笔记</text>
      <text class="summary-text" wx:if="{{pinnedCount > 0}}">· {{pinnedCount}} 篇置顶</text>
    </view>

    <view
      class="list-item"
      wx:for="{{items}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpen"
      bindlongpress="onLongPress"
    >
      <view class="list-item-bar" style="background: {{item.color}};"></view>

      <view class="list-item-head">
        <text class="list-item-title ellipsis">{{item.title}}</text>
        <text class="list-item-time">{{item.time}}</text>
      </view>

      <text class="list-item-sub ellipsis">{{item.preview}}</text>

      <view class="list-item-meta">
        <text class="pin" wx:if="{{item.pinned}}">置顶</text>
        <app-tag text="{{item.categoryLabel}}" color="{{item.color}}" />
        <app-tag wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this" text="#{{t}}" />
      </view>
    </view>

    <app-empty
      wx:if="{{count === 0}}"
      text="还没有笔记，记下第一条吧"
      actionText="新建笔记"
      bind:action="onCreate"
    />

    <view class="bottom-space"></view>
  </view>

  <app-fab bind:tap="onCreate" />
</view>
