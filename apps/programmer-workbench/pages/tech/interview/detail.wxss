/* 面试题库 · 详情 */

.review-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  margin-bottom: 32rpx;
  border-radius: 20rpx;
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
}

.review-main {
  display: flex;
  flex-direction: column;
}

.review-count {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.review-time {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.review-btn {
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--brand-soft, rgba(2, 132, 199, 0.12));
  color: var(--brand, #0284C7);
  font-size: 24rpx;
  display: flex;
  align-items: center;
}

.answer-area {
  min-height: 320rpx;
}

.delete {
  margin-top: 32rpx;
  width: 100%;
}
