<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <app-header title="面试题库" showBack />

  <view class="page-body">
    <view class="summary">
      <text class="summary-text">{{count}} 道题</text>
      <text class="summary-text" wx:if="{{starredCount > 0}}">· {{starredCount}} 道收藏</text>
    </view>

    <view
      class="list-item"
      wx:for="{{items}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpen"
      bindlongpress="onLongPress"
    >
      <view class="list-item-bar" style="background: {{item.color}};"></view>

      <view class="q-head">
        <text class="q-text">{{item.question}}</text>
      </view>

      <view class="list-item-meta">
        <text class="star" wx:if="{{item.starred}}">收藏</text>
        <app-tag text="{{item.difficultyLabel}}" color="{{item.difficultyColor}}" />
        <app-tag text="{{item.categoryLabel}}" color="{{item.color}}" />
        <app-tag text="复习 {{item.reviewCount}} 次" />
      </view>
    </view>

    <app-empty
      wx:if="{{count === 0}}"
      text="还没有题目，添加第一道吧"
      actionText="新建题目"
      bind:action="onCreate"
    />

    <view class="bottom-space"></view>
  </view>

  <app-fab bind:tap="onCreate" />
</view>
