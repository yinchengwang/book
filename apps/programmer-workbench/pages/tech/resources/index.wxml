<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <app-header title="资源收藏" showBack />

  <view class="page-body">
    <view class="summary">
      <text class="summary-text">{{count}} 个资源</text>
      <text class="summary-text" wx:if="{{archivedCount > 0}}">· {{archivedCount}} 个已归档</text>
    </view>

    <view
      class="list-item {{item.archived ? 'is-archived' : ''}}"
      wx:for="{{items}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpen"
    >
      <view class="list-item-bar" style="background: {{item.color}};"></view>

      <view class="list-item-head">
        <text class="list-item-title ellipsis">{{item.title}}</text>
        <view class="stars">
          <view
            class="star-dot {{s <= item.stars ? 'is-on' : ''}}"
            wx:for="{{[1,2,3,4,5]}}"
            wx:for-item="s"
            wx:key="*this"
          ></view>
        </view>
      </view>

      <text class="list-item-sub ellipsis" wx:if="{{item.note}}">{{item.note}}</text>

      <view class="list-item-meta">
        <text class="arch" wx:if="{{item.archived}}">已归档</text>
        <app-tag text="{{item.typeLabel}}" />
        <app-tag text="{{item.categoryLabel}}" color="{{item.color}}" />
      </view>
    </view>

    <app-empty
      wx:if="{{count === 0}}"
      text="还没有收藏的资源"
      actionText="添加资源"
      bind:action="onCreate"
    />

    <view class="bottom-space"></view>
  </view>

  <app-fab bind:tap="onCreate" />

  <!-- ==================== 编辑面板 ==================== -->
  <view class="panel" wx:if="{{editing}}">
    <view class="panel-head">
      <text class="panel-title">{{isEdit ? '编辑资源' : '添加资源'}}</text>
      <view class="panel-close" bindtap="onClosePanel">×</view>
    </view>

    <scroll-view scroll-y class="panel-body">
      <view class="field">
        <text class="field-label">标题</text>
        <input class="input" value="{{formTitle}}" placeholder="资源名称" placeholder-class="ph" bindinput="onFormTitle" />
      </view>

      <view class="field">
        <text class="field-label">链接（可选）</text>
        <input class="input mono" value="{{formUrl}}" placeholder="https://" placeholder-class="ph" bindinput="onFormUrl" />
      </view>

      <view class="field">
        <text class="field-label">类型</text>
        <view class="chips">
          <view
            class="chip {{item.active ? 'is-active' : ''}}"
            wx:for="{{types}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onFormType"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">分类</text>
        <view class="chips">
          <view
            class="chip {{item.active ? 'is-active' : ''}}"
            wx:for="{{categories}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onFormCategory"
            style="{{item.active ? 'background:' + item.color + ';border-color:' + item.color + ';' : ''}}"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">星级</text>
        <view class="star-picker">
          <view
            class="star-pick {{s <= formStars ? 'is-on' : ''}}"
            wx:for="{{starOptions}}"
            wx:for-item="s"
            wx:key="*this"
            data-star="{{s}}"
            bindtap="onFormStars"
          ></view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">备注（可选）</text>
        <textarea class="textarea" value="{{formNote}}" placeholder="为什么值得收藏" placeholder-class="ph" bindinput="onFormNote" />
      </view>

      <view class="field">
        <view class="editor-head">
          <text class="field-label">归档</text>
          <text class="toggle" bindtap="onToggleArchived">{{formArchived ? '已归档' : '未归档'}}</text>
        </view>
      </view>

      <view class="actions">
        <view class="btn-ghost act" bindtap="onClosePanel">取消</view>
        <view class="btn-primary act" bindtap="onSave">保存</view>
      </view>
    </scroll-view>
  </view>
</view>
