/* 今日 —— 首屏 */

/* ==================== 头部 ==================== */

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 40rpx 8rpx 24rpx;
}

.hero-date {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.hero-greeting {
  display: block;
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.25;
}

.hero-action {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  border: 0.5px solid var(--border);
  background: var(--bg-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 人物图标：圆头 + 半圆肩 */
.ic-person {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.ic-person::before {
  content: '';
  position: absolute;
  top: 3rpx;
  left: 11rpx;
  width: 14rpx;
  height: 14rpx;
  border: 2.5rpx solid var(--text-secondary);
  border-radius: 50%;
}

.ic-person::after {
  content: '';
  position: absolute;
  bottom: 3rpx;
  left: 4rpx;
  width: 28rpx;
  height: 13rpx;
  border: 2.5rpx solid var(--text-secondary);
  border-bottom: none;
  border-radius: 14rpx 14rpx 0 0;
}

/* ==================== 今日待办 ==================== */

.todo-card {
  padding: 24rpx 24rpx 8rpx;
}

.todo-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.todo-head-right {
  display: flex;
  align-items: center;
}

.todo-count {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-right: 20rpx;
}

.add-btn {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: var(--bg-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-btn:active {
  background: var(--brand-soft, rgba(2, 132, 199, 0.12));
}

.add-h {
  position: absolute;
  width: 22rpx;
  height: 2.5rpx;
  background: var(--brand, #0284C7);
  border-radius: 2rpx;
}

.add-v {
  position: absolute;
  width: 2.5rpx;
  height: 22rpx;
  background: var(--brand, #0284C7);
  border-radius: 2rpx;
}

.todo-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 0.5px solid var(--border);
}

/* 勾选圆 */
.check {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2.5rpx solid var(--border-strong);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check.is-done {
  background: var(--brand, #0284C7);
  border-color: var(--brand, #0284C7);
}

/* 勾：两条边框旋转 45° */
.check.is-done::after {
  content: '';
  width: 8rpx;
  height: 14rpx;
  border-right: 3rpx solid #FFFFFF;
  border-bottom: 3rpx solid #FFFFFF;
  transform: rotate(45deg) translate(-1rpx, -1rpx);
}

.todo-main {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.todo-title {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.4;
}

.todo-title.is-done {
  color: var(--text-muted);
  text-decoration: line-through;
}

.todo-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 优先级圆点：6px */
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.todo-empty {
  padding: 32rpx 0;
  text-align: center;
}

.todo-more {
  padding: 20rpx 0 24rpx;
  border-top: 0.5px solid var(--border);
  font-size: 24rpx;
  color: var(--brand, #0284C7);
  text-align: center;
}

/* ==================== 指标带 ==================== */

.stats {
  display: flex;
  margin-top: 16rpx;
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
  border-radius: 24rpx;
  overflow: hidden;
}

.stat {
  flex: 1;
  padding: 24rpx 8rpx;
  text-align: center;
  border-right: 0.5px solid var(--border);
}

.stat:last-child {
  border-right: none;
}

.stat-value {
  display: block;
  font-size: 38rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.2;
}

.stat-value.is-hl {
  color: var(--brand, #0284C7);
}

.stat-label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* ==================== 心情打卡 ==================== */

.mood-card {
  margin-top: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mood-main {
  display: flex;
  flex-direction: column;
}

.mood-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.mood-current {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.mood-dots {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.mood-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2.5rpx solid var(--border-strong);
  transition: transform 150ms ease;
}

.mood-dot.is-active {
  border-color: transparent;
  transform: scale(1.12);
}

/* ==================== 快捷入口 ==================== */

.shortcuts {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
}

.shortcut {
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx 0 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.shortcut:active {
  background: var(--bg-tertiary);
}

.shortcut-icon {
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shortcut-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-primary);
}

/* ---------- 快捷图标（纯 CSS，零图片资源） ---------- */

.ic-doc {
  width: 30rpx;
  height: 36rpx;
  border: 2.5rpx solid var(--brand, #0284C7);
  border-radius: 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
}

.ic-line {
  width: 16rpx;
  height: 2.5rpx;
  background: var(--brand, #0284C7);
  border-radius: 2rpx;
}

.ic-line.short {
  width: 10rpx;
  margin-right: 6rpx;
}

.ic-code {
  position: relative;
  width: 40rpx;
  height: 36rpx;
}

.ic-chev-l,
.ic-chev-r {
  position: absolute;
  top: 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 2.5rpx solid var(--brand, #0284C7);
  border-right: 2.5rpx solid var(--brand, #0284C7);
}

.ic-chev-l {
  left: 5rpx;
  transform: rotate(-135deg);
}

.ic-chev-r {
  right: 5rpx;
  transform: rotate(45deg);
}

.ic-plus {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.ic-h {
  position: absolute;
  top: 17rpx;
  left: 0;
  width: 36rpx;
  height: 2.5rpx;
  background: var(--brand, #0284C7);
  border-radius: 2rpx;
}

.ic-v {
  position: absolute;
  left: 17rpx;
  top: 0;
  width: 2.5rpx;
  height: 36rpx;
  background: var(--brand, #0284C7);
  border-radius: 2rpx;
}

.ic-cal {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  border: 2.5rpx solid var(--brand, #0284C7);
  border-radius: 5rpx;
}

.ic-cal-bar {
  position: absolute;
  top: 8rpx;
  left: 0;
  right: 0;
  height: 2.5rpx;
  background: var(--brand, #0284C7);
}

.ic-diamond {
  width: 24rpx;
  height: 24rpx;
  border: 2.5rpx solid var(--brand, #0284C7);
  border-radius: 3rpx;
  transform: rotate(45deg);
}

/* ==================== 底部提示 ==================== */

.hint {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
}
