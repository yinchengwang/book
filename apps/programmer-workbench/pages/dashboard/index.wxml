<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <view class="page-body">

    <!-- 头部：日期 + 问候 + 资料入口 -->
    <view class="hero">
      <view class="hero-main">
        <text class="hero-date">{{dateLabel}}</text>
        <text class="hero-greeting">{{greeting}}，{{nickname}}</text>
      </view>
      <view class="hero-action" bindtap="onGoProfile">
        <view class="ic-person"></view>
      </view>
    </view>

    <!-- 今日待办 -->
    <view class="card todo-card">
      <view class="todo-head">
        <text class="card-title">今日待办</text>
        <view class="todo-head-right">
          <text class="todo-count num">{{todoOpenCount}} / {{todoTotal}}</text>
          <view class="add-btn" bindtap="onAddTodo">
            <view class="add-h"></view>
            <view class="add-v"></view>
          </view>
        </view>
      </view>

      <view class="todo-row" wx:for="{{todoItems}}" wx:key="id">
        <view
          class="check {{item.done ? 'is-done' : ''}}"
          data-id="{{item.id}}"
          bindtap="onToggleTodo"
        ></view>
        <view class="todo-main" data-id="{{item.id}}" bindtap="onCyclePriority">
          <text class="todo-title ellipsis {{item.done ? 'is-done' : ''}}">{{item.title}}</text>
          <text class="todo-sub">
            {{item.categoryLabel}}{{item.categoryLabel && item.priorityLabel ? ' · ' : ''}}{{item.priorityLabel}}
          </text>
        </view>
        <view class="dot" style="background: {{item.barColor}};"></view>
      </view>

      <view class="todo-empty" wx:if="{{todoOpenCount === 0}}">
        <text class="t-caption">今天没有待办，享受空白</text>
      </view>

      <view class="todo-more" wx:if="{{todoMoreCount > 0 && !showAllTodos}}" bindtap="onToggleAllTodos">
        还有 {{todoMoreCount}} 项
      </view>
      <view class="todo-more" wx:if="{{showAllTodos && todoOpenCount > 3}}" bindtap="onToggleAllTodos">
        收起
      </view>
    </view>

    <!-- 4 指标带 -->
    <view class="stats">
      <view class="stat" wx:for="{{stats}}" wx:key="key">
        <text class="stat-value num {{item.highlight ? 'is-hl' : ''}}">{{item.value}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>

    <!-- 心情打卡 -->
    <view class="card mood-card">
      <view class="mood-main">
        <text class="mood-title">今日心情</text>
        <text class="mood-current">{{moodLabel}}</text>
      </view>
      <view class="mood-dots">
        <view
          class="mood-dot {{item.active ? 'is-active' : ''}}"
          wx:for="{{moodLevels}}"
          wx:key="level"
          style="{{item.active ? 'background:' + item.color + ';' : ''}}"
          data-level="{{item.level}}"
          bindtap="onSetMood"
        ></view>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="shortcuts">
      <view
        class="shortcut"
        wx:for="{{shortcuts}}"
        wx:key="key"
        data-path="{{item.path}}"
        bindtap="onGoShortcut"
      >
        <view class="shortcut-icon">
          <view class="ic-doc" wx:if="{{item.key === 'notes'}}">
            <view class="ic-line"></view>
            <view class="ic-line short"></view>
          </view>
          <view class="ic-code" wx:if="{{item.key === 'snippets'}}">
            <view class="ic-chev-l"></view>
            <view class="ic-chev-r"></view>
          </view>
          <view class="ic-plus" wx:if="{{item.key === 'insights'}}">
            <view class="ic-h"></view>
            <view class="ic-v"></view>
          </view>
          <view class="ic-cal" wx:if="{{item.key === 'schedule'}}">
            <view class="ic-cal-bar"></view>
          </view>
          <view class="ic-diamond" wx:if="{{item.key === 'projects'}}"></view>
        </view>
        <text class="shortcut-label">{{item.label}}</text>
      </view>
    </view>

    <view class="hint">点待办文字可切换优先级</view>
  </view>

  <app-fab bottom="{{140}}" bind:tap="onOpenCapture" />
  <capture-sheet
    visible="{{captureVisible}}"
    bind:close="onCloseCapture"
    bind:created="onCaptured"
  />
</view>
