<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <app-header title="项目集" showBack />

  <view class="page-body">
    <view class="summary">
      <text class="summary-text">{{count}} 个项目</text>
      <text class="summary-text" wx:if="{{activeCount > 0}}">· {{activeCount}} 个进行中</text>
    </view>

    <view
      class="list-item"
      wx:for="{{items}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpen"
      bindlongpress="onLongPress"
    >
      <view class="list-item-bar" style="background: {{item.color}};"></view>

      <view class="list-item-head">
        <text class="list-item-title ellipsis">{{item.name}}</text>
        <text class="list-item-time">{{item.statusLabel}}</text>
      </view>

      <text class="list-item-sub" wx:if="{{item.description}}">{{item.description}}</text>

      <!-- 亮点 -->
      <view class="highlights" wx:if="{{item.highlights.length > 0}}">
        <view class="highlight" wx:for="{{item.highlights}}" wx:for-item="h" wx:key="*this">
          <view class="bullet"></view>
          <text class="highlight-text">{{h}}</text>
        </view>
      </view>

      <!-- 技术栈 -->
      <view class="list-item-meta" wx:if="{{item.techStack.length > 0}}">
        <app-tag wx:for="{{item.techStack}}" wx:for-item="t" wx:key="*this" text="{{t}}" />
      </view>

      <!-- 星级与链接 -->
      <view class="card-foot">
        <view class="rating" wx:if="{{item.stars > 0}}">
          <view
            class="rating-dot {{s <= item.stars ? 'is-on' : ''}}"
            wx:for="{{[1,2,3,4,5]}}"
            wx:for-item="s"
            wx:key="*this"
          ></view>
        </view>
        <view class="links">
          <text class="link" wx:if="{{item.repoUrl}}" data-url="{{item.repoUrl}}" catchtap="onCopyLink">复制仓库</text>
          <text class="link" wx:if="{{item.demoUrl}}" data-url="{{item.demoUrl}}" catchtap="onCopyLink">复制演示</text>
        </view>
      </view>
    </view>

    <app-empty
      wx:if="{{count === 0}}"
      text="还没有项目，展示一下你的作品吧"
      actionText="添加项目"
      bind:action="onCreate"
    />

    <view class="bottom-space"></view>
  </view>

  <app-fab bind:tap="onCreate" />

  <!-- ==================== 编辑面板 ==================== -->
  <view class="panel" wx:if="{{editing}}">
    <view class="panel-head">
      <text class="panel-title">{{isEdit ? '编辑项目' : '添加项目'}}</text>
      <view class="panel-close" bindtap="onClosePanel">×</view>
    </view>

    <scroll-view scroll-y class="panel-body">
      <view class="field">
        <text class="field-label">项目名</text>
        <input class="input" value="{{formName}}" placeholder="项目名称" placeholder-class="ph" bindinput="onFormName" />
      </view>

      <view class="field">
        <text class="field-label">简介</text>
        <textarea class="textarea" value="{{formDesc}}" placeholder="一句话说明它解决什么问题" placeholder-class="ph" bindinput="onFormDesc" />
      </view>

      <view class="field">
        <text class="field-label">技术栈（逗号分隔）</text>
        <input class="input" value="{{formStack}}" placeholder="例如：原生小程序, JavaScript" placeholder-class="ph" bindinput="onFormStack" />
      </view>

      <view class="field">
        <text class="field-label">亮点（每行一条）</text>
        <textarea class="textarea" value="{{formHighlights}}" placeholder="离线优先&#10;零依赖" placeholder-class="ph" bindinput="onFormHighlights" />
      </view>

      <view class="field">
        <text class="field-label">状态</text>
        <view class="chips">
          <view
            class="chip {{item.active ? 'is-active' : ''}}"
            wx:for="{{statuses}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onFormStatus"
            style="{{item.active ? 'background:' + item.color + ';border-color:' + item.color + ';' : ''}}"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">自评星级</text>
        <view class="rating-picker">
          <view
            class="rating-pick {{s <= formStars ? 'is-on' : ''}}"
            wx:for="{{starOptions}}"
            wx:for-item="s"
            wx:key="*this"
            data-star="{{s}}"
            bindtap="onFormStars"
          ></view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">仓库链接（可选）</text>
        <input class="input mono" value="{{formRepo}}" placeholder="https://" placeholder-class="ph" bindinput="onFormRepo" />
      </view>

      <view class="field">
        <text class="field-label">演示链接（可选）</text>
        <input class="input mono" value="{{formDemo}}" placeholder="https://" placeholder-class="ph" bindinput="onFormDemo" />
      </view>

      <view class="actions">
        <view class="btn-ghost act" bindtap="onClosePanel">取消</view>
        <view class="btn-primary act" bindtap="onSave">保存</view>
      </view>

      <view class="btn-danger delete" wx:if="{{isEdit}}" bindtap="onDelete">删除这个项目</view>
    </scroll-view>
  </view>
</view>
