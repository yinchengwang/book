/* app.wxss — 全局样式 */

page {
  --primary: #ff7e3e;
  --primary-dark: #e36422;
  --bg: #faf7f2;
  --bg-card: #ffffff;
  --text: #2b2620;
  --text-muted: #8b7f72;
  --text-faint: #c2b9ad;
  --border: #efe9df;
  --accent: #6b8e4e;
  --shadow: 0 4rpx 16rpx rgba(45, 35, 25, 0.06);

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

view, text, image, button, input, textarea {
  box-sizing: border-box;
}

.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-col { display: flex; flex-direction: column; }
.gap-8 { gap: 16rpx; }
.gap-16 { gap: 32rpx; }
.spacer { flex: 1; }
.muted { color: var(--text-muted); }
.faint { color: var(--text-faint); }

.empty-state {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 120rpx 60rpx;
  color: var(--text-muted);
}
.empty-state .icon { font-size: 120rpx; margin-bottom: 32rpx; }
.empty-state .title { font-size: 36rpx; font-weight: 600; color: var(--text); margin-bottom: 16rpx; }
.empty-state .hint { font-size: 26rpx; }
