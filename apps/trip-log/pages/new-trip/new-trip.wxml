<!-- pages/new-trip/new-trip.wxml -->
<form bindsubmit="save" class="form">
  <view class="form-row">
    <view class="label">标题 <text class="req">*</text></view>
    <input class="ipt" name="title" placeholder="给这次出行起个名字" value="{{form.title}}" bindinput="onInput" data-field="title" />
  </view>

  <view class="row-grid">
    <view class="form-row">
      <view class="label">日期 <text class="req">*</text></view>
      <picker mode="date" value="{{form.date}}" start="2000-01-01" end="2099-12-31" bindchange="onDate">
        <view class="ipt picker">{{form.date || '请选择'}}</view>
      </picker>
    </view>
    <view class="form-row">
      <view class="label">天气</view>
      <input class="ipt" placeholder="晴 / 小雨…" value="{{form.weather}}" bindinput="onInput" data-field="weather" />
    </view>
  </view>

  <view class="form-row">
    <view class="label">地点</view>
    <input class="ipt" placeholder="城市或具体地点" value="{{form.location}}" bindinput="onInput" data-field="location" />
  </view>

  <view class="form-row">
    <view class="label">同行人</view>
    <input class="ipt" placeholder="谁一起去的？逗号分隔" value="{{form.companions}}" bindinput="onInput" data-field="companions" />
  </view>

  <view class="form-row">
    <view class="label">标签</view>
    <input class="ipt" placeholder="徒步, 美食, 海边... 逗号分隔" value="{{form.tagsText}}" bindinput="onInput" data-field="tagsText" />
  </view>

  <view class="form-row">
    <view class="label">照片</view>
    <view class="photos">
      <view wx:for="{{localPhotos}}" wx:key="path" wx:for-item="p" class="photo-cell">
        <image src="{{p.path}}" mode="aspectFill" bindtap="previewPhoto" data-path="{{p.path}}" />
        <view class="photo-x" catchtap="removePhoto" data-path="{{p.path}}">×</view>
      </view>
      <view class="photo-add" bindtap="pickPhotos">
        <view class="add-icon">+</view>
        <view class="add-label">添加</view>
      </view>
    </view>
    <view class="hint">{{localPhotos.length}} 张 · 上传时单张 ≤ 5MB</view>
  </view>

  <view class="form-row">
    <view class="label">感想 / 备注</view>
    <textarea class="ipt area" placeholder="今天发生了什么？看到了什么？值得记住的瞬间…" value="{{form.notes}}" bindinput="onInput" data-field="notes" />
  </view>

  <view style="height:60rpx"></view>

  <view class="actions">
    <button class="btn ghost" bindtap="cancel">取消</button>
    <button class="btn primary" form-type="submit" disabled="{{saving}}">{{saving ? '保存中…' : '保存'}}</button>
  </view>

  <view style="height:80rpx"></view>
</form>
