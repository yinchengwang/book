/* pages/new-trip/new-trip.wxss */
.form {
  padding: 24rpx;
  padding-bottom: 0;
}

.row-grid {
  display: flex;
  gap: 20rpx;
}
.row-grid .form-row { flex: 1; }

.form-row {
  margin-bottom: 28rpx;
}

.form-row .label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}
.form-row .req { color: var(--primary); }

.ipt {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  min-height: 80rpx;
  color: var(--text);
  border: 1rpx solid var(--border);
}

.ipt.area {
  min-height: 200rpx;
  padding: 20rpx 24rpx;
  line-height: 1.6;
}

.picker { display: flex; align-items: center; }

.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #eee;
}
.photo-cell image {
  width: 100%;
  height: 100%;
}
.photo-x {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.55);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  border: 2rpx dashed var(--text-faint);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  background: #fff;
}
.photo-add .add-icon { font-size: 60rpx; color: var(--text-faint); line-height: 1; }
.photo-add .add-label { font-size: 22rpx; margin-top: 8rpx; }

.hint {
  font-size: 22rpx;
  color: var(--text-faint);
  margin-top: 12rpx;
}

.actions {
  position: fixed;
  left: 0; right: 0;
  bottom: 0;
  padding: 24rpx;
  display: flex;
  gap: 20rpx;
  background: var(--bg);
  border-top: 1rpx solid var(--border);
}

.btn {
  flex: 1;
  border: none;
  border-radius: 100rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}
.btn.primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: white;
  box-shadow: 0 6rpx 16rpx rgba(255, 126, 62, 0.35);
}
.btn.ghost {
  background: white;
  color: var(--text);
  border: 1rpx solid var(--border);
}
.btn[disabled] { opacity: 0.6; }
