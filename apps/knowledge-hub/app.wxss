/* app.wxss —— DevBench 全局样式
 *
 * 设计令牌 + 通用组件类。18 个页面的视觉基准全部来自这里，
 * 页面自身的 wxss 只写一次性布局，不重复定义颜色/字号/圆角。
 *
 * 令牌换算：1px = 2rpx（按 375 设计稿）
 *   字阶  display 22px=44rpx / title 17px=34rpx / body 14px=28rpx / caption 12px=24rpx
 *   间距  4/8/12/16/24px = 8/16/24/32/48rpx
 *   圆角  卡片 12px=24rpx / 控件 8px=16rpx / 胶囊 999rpx
 */

/* ==================== 主题变量 ==================== */

.theme-light {
  --bg-primary: #F7F8FA;
  --bg-secondary: #FFFFFF;
  --bg-tertiary: #F1F3F5;
  --bg-inverse: #0F172A;

  --text-primary: #0F172A;
  --text-secondary: #64748B;
  --text-muted: #94A3B8;
  --text-inverse: #FFFFFF;

  --border: #E4E7EC;
  --border-strong: #CBD5E1;

  --danger: #E5484D;
  --warning: #F5A524;
  --success: #30A46C;
  --accent: #7F77DD;

  --code-bg: #F1F3F5;
  --code-text: #0F172A;
}

.theme-dark {
  --bg-primary: #0B0F17;
  --bg-secondary: #151A23;
  --bg-tertiary: #1D2430;
  --bg-inverse: #E6EAF0;

  --text-primary: #E6EAF0;
  --text-secondary: #94A3B8;
  --text-muted: #64748B;
  --text-inverse: #0B0F17;

  --border: #232B38;
  --border-strong: #33404F;

  --danger: #E5484D;
  --warning: #F5A524;
  --success: #30A46C;
  --accent: #7F77DD;

  --code-bg: #1D2430;
  --code-text: #E6EAF0;
}

/* ==================== 基础 ==================== */

page {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, button, input, textarea {
  box-sizing: border-box;
}

/* 页面根容器：承载主题变量与底色 */
.page {
  min-height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
  padding-bottom: 48rpx;
}

/* 带左右留白的内容区 */
.page-body {
  padding: 0 32rpx;
}

/* ==================== 字阶 ==================== */

.t-display {
  font-size: 44rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.2;
}

.t-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.3;
}

.t-body {
  font-size: 28rpx;
  font-weight: 400;
  color: var(--text-primary);
}

.t-caption {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-secondary);
}

.t-muted {
  color: var(--text-muted);
}

/* 数字：等宽对齐，避免动态数值抖动 */
.num {
  font-variant-numeric: tabular-nums;
}

/* 单行截断 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 布局工具 */
.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grow {
  flex: 1;
  min-width: 0;
}

/* ==================== 卡片 ==================== */

.card {
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
  border-radius: 24rpx;
  padding: 32rpx;
}

.card-tight {
  padding: 24rpx;
}

.card-flat {
  border-radius: 20rpx;
  padding: 24rpx;
}

/* 区块标题（卡片内） */
.card-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

/* ==================== 列表卡范式 ====================
 *
 * 18 页通用：
 *   ┃ 标题                    相对时间
 *   ┃ 分类 · 标签
 *
 * 左侧 6rpx 色条承载优先级/分类语义，不额外占空间。
 * 整卡可点，卡内不放独立按钮，避免误触。
 */

.list-item {
  position: relative;
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx 24rpx 24rpx 32rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.list-item:active {
  background: var(--bg-tertiary);
}

/* 左色条：由页面传入具体色值 */
.list-item-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
}

.list-item-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.list-item-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.4;
}

.list-item-title.is-done {
  color: var(--text-muted);
  text-decoration: line-through;
}

.list-item-time {
  font-size: 22rpx;
  color: var(--text-muted);
  flex-shrink: 0;
  padding-left: 16rpx;
  font-variant-numeric: tabular-nums;
}

.list-item-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.list-item-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

/* ==================== 页面标题区 ==================== */

.page-head {
  padding: 40rpx 8rpx 24rpx;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.25;
}

.page-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ==================== 标签 ==================== */

.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  background: var(--bg-tertiary);
}

.tag-brand {
  color: var(--brand, #0284C7);
  background: var(--brand-soft, rgba(2, 132, 199, 0.12));
}

.tag-danger {
  color: var(--danger);
  background: rgba(229, 72, 77, 0.12);
}

.tag-warning {
  color: var(--warning);
  background: rgba(245, 165, 36, 0.14);
}

.tag-success {
  color: var(--success);
  background: rgba(48, 164, 108, 0.14);
}

/* ==================== 按钮 ==================== */

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  background: var(--brand, #0284C7);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  background: transparent;
  color: var(--text-secondary);
  font-size: 28rpx;
  border: 0.5px solid var(--border-strong);
}

.btn-ghost:active {
  background: var(--bg-tertiary);
}

.btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  background: transparent;
  color: var(--danger);
  font-size: 28rpx;
  border: 0.5px solid var(--danger);
}

.btn-danger:active {
  background: rgba(229, 72, 77, 0.1);
}

/* 覆盖原生 button 默认样式 */
button {
  padding: 0;
  margin: 0;
  line-height: normal;
  background: transparent;
}

button::after {
  border: none;
}

/* ==================== 空状态 ==================== */

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 48rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-muted);
  text-align: center;
}

.empty-action {
  margin-top: 32rpx;
}

/* ==================== 悬浮新建按钮 ==================== */

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 48rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--brand, #0284C7);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.16);
  z-index: 50;
}

.fab:active {
  opacity: 0.85;
}

/* ==================== 分组标题 ==================== */

.group-title {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-secondary);
  padding: 32rpx 8rpx 16rpx;
}

/* ==================== 分隔线 ==================== */

.divider {
  height: 0.5px;
  background: var(--border);
  margin: 24rpx 0;
}

/* ==================== 表单 ==================== */

.field {
  margin-bottom: 32rpx;
}

.field-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--bg-tertiary);
  font-size: 28rpx;
  color: var(--text-primary);
}

.textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--bg-tertiary);
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-primary);
}

/* 等宽（代码/数值展示） */
.mono {
  font-family: ui-monospace, Menlo, Monaco, Consolas, monospace;
}

/* ==================== 胶囊选择器 ==================== */

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: 0.5px solid var(--border);
  background: var(--bg-secondary);
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.chip.is-active {
  background: var(--brand, #0284C7);
  border-color: var(--brand, #0284C7);
  color: #FFFFFF;
}

/* ==================== 编辑器通用 ==================== */

.ph {
  color: var(--text-muted);
}

.editor-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.toggle {
  font-size: 24rpx;
  color: var(--brand, #0284C7);
  padding: 8rpx 0 8rpx 24rpx;
}

.preview-box {
  min-height: 320rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.act {
  flex: 1;
  height: 84rpx;
  font-size: 28rpx;
}

/* ==================== 全屏编辑面板 ====================
 *
 * 无独立详情页的模块（资源收藏 / 读书 / 健身 / 日程）用此面板就地编辑。
 * 覆盖层而非新页面，不增加页面数。
 */

.panel {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--bg-primary);
  display: flex;
  flex-direction: column;
  z-index: 100;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  padding: 0 24rpx;
  border-bottom: 0.5px solid var(--border);
  flex-shrink: 0;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.panel-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--text-secondary);
}

/* height:0 + flex:1 让 scroll-view 撑满剩余空间 */
.panel-body {
  flex: 1;
  height: 0;
  padding: 24rpx 32rpx 64rpx;
}

/* 列表页底部留白，避免被 FAB 遮挡 */
.bottom-space {
  height: 160rpx;
}

/* ==================== 列表页摘要行 ==================== */

.summary {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 8rpx 8rpx 20rpx;
}

.summary-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 列表卡上的小徽标（置顶 / 收藏 / 已归档） */
.flag {
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  background: var(--brand-soft, rgba(2, 132, 199, 0.12));
  color: var(--brand, #0284C7);
}

.flag-warning {
  background: rgba(245, 165, 36, 0.14);
  color: var(--warning);
}

.flag-muted {
  background: var(--bg-tertiary);
  color: var(--text-muted);
}

/* ==================== 聚合入口行 ====================
 *
 * 技术栈 / 生活 两个 tab 的模块入口共用。
 */

.entry {
  display: flex;
  align-items: center;
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
}

.entry:active {
  background: var(--bg-tertiary);
}

.entry-symbol {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--brand-soft, rgba(2, 132, 199, 0.12));
  color: var(--brand, #0284C7);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: ui-monospace, Menlo, Monaco, monospace;
  font-size: 28rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.entry-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.entry-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.entry-count {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--brand, #0284C7);
  padding-left: 16rpx;
}

.entry-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.entry-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--text-muted);
  border-right: 3rpx solid var(--text-muted);
  transform: rotate(45deg);
  margin-left: 20rpx;
  flex-shrink: 0;
}

/* ==================== 五点选择器 / 星级 ==================== */

.rating-picker {
  display: flex;
  gap: 20rpx;
}

.rating-pick {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2.5rpx solid var(--border-strong);
}

.rating-pick.is-on {
  background: var(--warning);
  border-color: var(--warning);
}

/* 只读星级：卡片上的小圆点 */
.rating {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.rating-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--border-strong);
}

.rating-dot.is-on {
  background: var(--warning);
}

/* ==================== 进度行 ==================== */

.progress-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

.progress-row app-progress-bar {
  flex: 1;
  min-width: 0;
}

.progress-text {
  font-size: 22rpx;
  color: var(--text-muted);
  flex-shrink: 0;
}

/* ==================== 两列字段 ==================== */

.two-col {
  display: flex;
  gap: 20rpx;
}

.two-col .col {
  flex: 1;
  min-width: 0;
}

/* ==================== 危险操作 ==================== */

.delete {
  margin-top: 32rpx;
  width: 100%;
}

/* 代码块 */
.code-block {
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--code-bg);
  color: var(--code-text);
  font-family: ui-monospace, Menlo, Monaco, Consolas, monospace;
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

/* rich-text 内 Markdown 元素样式 */
.md-h1 { font-size: 40rpx; font-weight: 500; margin: 24rpx 0 12rpx; }
.md-h2 { font-size: 34rpx; font-weight: 500; margin: 20rpx 0 12rpx; }
.md-h3 { font-size: 30rpx; font-weight: 500; margin: 16rpx 0 8rpx; }
.md-p { margin: 12rpx 0; }
.md-code {
  display: block;
  padding: 20rpx;
  border-radius: 12rpx;
  background: var(--code-bg);
  font-family: ui-monospace, Menlo, monospace;
  font-size: 24rpx;
  line-height: 1.6;
  margin: 16rpx 0;
  white-space: pre-wrap;
}
.md-inline-code {
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  background: var(--code-bg);
  font-family: ui-monospace, Menlo, monospace;
  font-size: 26rpx;
}
