.header {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 8rpx;
}

.side {
  width: 96rpx;
  display: flex;
  align-items: center;
}

.side.right {
  justify-content: flex-end;
}

/* 返回箭头：用边框拼出 chevron，零图片资源 */
.back-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chevron {
  width: 16rpx;
  height: 16rpx;
  border-left: 3rpx solid var(--text-primary);
  border-bottom: 3rpx solid var(--text-primary);
  transform: rotate(45deg);
  margin-left: 6rpx;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.right-text {
  font-size: 28rpx;
  color: var(--brand, #0284C7);
}
