.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  background: var(--bg-tertiary);
  white-space: nowrap;
}

.tag-brand {
  color: var(--brand, #0284C7);
  background: var(--brand-soft, rgba(2, 132, 199, 0.12));
}

.tag-danger {
  color: var(--danger);
  background: rgba(229, 72, 77, 0.12);
}

.tag-warning {
  color: var(--warning);
  background: rgba(245, 165, 36, 0.14);
}

.tag-success {
  color: var(--success);
  background: rgba(48, 164, 108, 0.14);
}
