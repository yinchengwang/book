.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 48rpx;
}

/* 用两条横线做极简空态图形，避免引入图片资源 */
.mark {
  width: 96rpx;
  height: 72rpx;
  border: 0.5px solid var(--border-strong);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 32rpx;
}

.line {
  width: 48rpx;
  height: 2rpx;
  background: var(--border-strong);
  border-radius: 2rpx;
}

.line.short {
  width: 28rpx;
}

.text {
  font-size: 28rpx;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.6;
}

.action {
  margin-top: 32rpx;
  height: 72rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  border: 0.5px solid var(--brand, #0284C7);
  display: flex;
  align-items: center;
}

.action:active {
  background: var(--brand-soft, rgba(2, 132, 199, 0.12));
}

.action-text {
  font-size: 26rpx;
  color: var(--brand, #0284C7);
}
