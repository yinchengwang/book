/* 首页仪表盘 —— 只写一次性布局，颜色/字号继承 app.wxss 令牌 */

.plan-num {
  margin: 16rpx 0 12rpx;
}

.plan-done {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.plan-total {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.stat-cell {
  flex: 1 1 30%;
  min-width: 180rpx;
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.stack-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 14rpx 0;
}

.stack-row + .stack-row {
  border-top: 0.5px solid var(--border);
}

.stack-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.stack-main {
  flex: 1;
  min-width: 0;
}

.stack-label {
  font-size: 26rpx;
  color: var(--text-primary);
}

.stack-count {
  font-size: 22rpx;
  color: var(--text-muted);
}

.gap-row {
  padding: 12rpx 0;
}

.gap-label {
  font-size: 26rpx;
  color: var(--text-primary);
}

.gap-num {
  font-size: 22rpx;
  color: var(--text-muted);
}