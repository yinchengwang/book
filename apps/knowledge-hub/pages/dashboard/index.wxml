<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <view class="page-body">

    <view class="page-head">
      <text class="page-title">{{greeting}}</text>
      <text class="page-sub">{{todayLabel}}</text>
    </view>

    <!-- 今日计划 -->
    <view class="card" bindtap="onOpenPlan">
      <view class="row-between">
        <text class="card-title">今日刷题计划</text>
        <text class="tag tag-brand">{{plan.stackLabel}}</text>
      </view>
      <view class="plan-num">
        <text class="num plan-done">{{plan.completed}}</text>
        <text class="plan-total num"> / {{plan.total}} 题</text>
      </view>
      <progress-bar percent="{{planProgress}}" color="{{brand}}" />
    </view>

    <!-- 5 项统计 -->
    <view class="stat-grid">
      <view class="stat-cell" wx:for="{{stats}}" wx:key="key">
        <text class="stat-value num" style="color: {{item.color}};">{{item.value}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>

    <!-- 技术栈进度 -->
    <view class="group-title">技术栈进度</view>
    <view class="card">
      <view class="stack-row" wx:for="{{stackProgress}}" wx:key="key">
        <view class="stack-icon" style="background: {{item.color}};">{{item.icon}}</view>
        <view class="stack-main">
          <view class="row-between">
            <text class="stack-label">{{item.label}}</text>
            <text class="stack-count num">{{item.answered}}/{{item.total}}</text>
          </view>
          <progress-bar percent="{{item.percent}}" color="{{item.color}}" />
        </view>
      </view>
    </view>

    <!-- 能力盲点 -->
    <view class="group-title">待补强</view>
    <view class="card">
      <view class="gap-row" wx:for="{{gaps}}" wx:key="key">
        <view class="row-between">
          <text class="gap-label">{{item.label}}</text>
          <text class="gap-num num">{{item.level}} / {{item.target}}</text>
        </view>
        <progress-bar percent="{{item.percent}}" color="{{item.color}}" />
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="group-title">快捷入口</view>
    <view
      class="entry"
      wx:for="{{shortcuts}}"
      wx:key="key"
      data-path="{{item.path}}"
      bindtap="onOpen"
    >
      <view class="entry-symbol" style="background: {{item.color}}1F; color: {{item.color}};">{{item.symbol}}</view>
      <view class="entry-main">
        <text class="entry-title">{{item.title}}</text>
      </view>
      <view class="entry-arrow"></view>
    </view>

    <view class="bottom-space"></view>
  </view>
</view>