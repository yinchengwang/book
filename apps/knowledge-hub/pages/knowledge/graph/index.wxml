<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <view class="page-body">

    <view class="page-head">
      <text class="page-title">知识图谱</text>
      <text class="page-sub">{{nodes.length}} 节点 · {{links.length}} 条前置关系</text>
    </view>

    <!-- Canvas 关系图 -->
    <knowledge-graph nodes="{{nodes}}" links="{{links}}" selected-id="{{selectedId}}" brand="{{brand}}" />

    <!-- 领域筛选 -->
    <view class="chips">
      <view
        class="chip {{activeDomain === item.key ? 'is-active' : ''}}"
        wx:for="{{domains}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onPickDomain"
      >{{item.label}}</view>
    </view>

    <!-- 选中节点详情 -->
    <view class="card sel-card" wx:if="{{selected}}">
      <view class="row-between">
        <text class="sel-name">{{selected.name}}</text>
        <text class="flag" style="background: {{selected.color}}1F; color: {{selected.color}};">{{selected.domain}}</text>
      </view>
      <view class="row-between level-row">
        <text class="t-caption">掌握度 {{selected.level}} / 4</text>
        <view class="level-btns">
          <view class="level-btn" data-delta="-1" bindtap="onAdjust">−</view>
          <view class="level-btn" data-delta="1" bindtap="onAdjust">+</view>
        </view>
      </view>

      <view wx:if="{{related.length}}">
        <view class="divider"></view>
        <text class="t-caption">关联关系</text>
        <view class="rel-row" wx:for="{{related}}" wx:key="id" data-id="{{item.id}}" bindtap="onSelect">
          <text class="rel-dir">{{item.dir}}</text>
          <text class="rel-name grow">{{item.name}}</text>
          <view class="rel-dot" style="background: {{item.color}};"></view>
        </view>
      </view>

      <view class="btn-ghost close-btn" bindtap="onClose">取消选中</view>
    </view>

    <!-- 节点列表 -->
    <view class="group-title">节点（点选查看关系）</view>
    <view
      class="list-item {{selectedId === item.id ? 'is-sel' : ''}}"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onSelect"
    >
      <view class="list-item-bar" style="background: {{item.color}};"></view>
      <view class="list-item-head">
        <text class="list-item-title">{{item.name}}</text>
        <text class="list-item-time">Lv.{{item.level}}</text>
      </view>
      <text class="list-item-sub">{{item.domain}}</text>
    </view>

    <view class="bottom-space"></view>
  </view>
</view>