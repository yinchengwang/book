<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <view class="page-body">

    <view class="page-head">
      <text class="page-title">摘抄管理</text>
      <text class="page-sub">{{stats.total}} 条 · {{stats.favorites}} 收藏 · {{stats.books}} 本书</text>
    </view>

    <input class="input search-input" value="{{query}}" bindinput="onSearch" placeholder="搜索摘抄内容或书名" />

    <view class="chips" wx:if="{{books.length}}">
      <view
        class="chip {{filterBook === item ? 'is-active' : ''}}"
        wx:for="{{books}}"
        wx:key="*this"
        data-book="{{item}}"
        bindtap="onPickBook"
      >{{item}}</view>
    </view>

    <view class="chips" wx:if="{{tags.length}}">
      <view
        class="chip tag-chip {{filterTag === item ? 'is-active' : ''}}"
        wx:for="{{tags}}"
        wx:key="*this"
        data-tag="{{item}}"
        bindtap="onPickTag"
      >#{{item}}</view>
    </view>

    <view
      class="list-item"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpen"
    >
      <view class="list-item-bar" style="background: {{item.favorite ? '#F5A524' : item.statusColor}};"></view>
      <view class="list-item-head">
        <text class="list-item-title">{{item.content}}</text>
        <text class="list-item-time">{{item.date}}</text>
      </view>
      <view class="list-item-meta">
        <text class="tag" wx:if="{{item.book}}">{{item.book}}</text>
        <text class="flag" style="background: {{item.statusColor}}1F; color: {{item.statusColor}};">{{item.statusLabel}}</text>
        <text class="tag tag-warning" wx:if="{{item.favorite}}">★</text>
      </view>
    </view>

    <app-empty wx:if="{{list.length === 0}}" text="没有匹配的摘抄" action-text="添加摘抄" bind:action="onOpenAdd" />
    <view class="bottom-space"></view>
  </view>

  <app-fab bottom="{{140}}" bind:tap="onOpenAdd" />

  <!-- 详情 -->
  <view class="panel" wx:if="{{current}}">
    <view class="panel-head">
      <view class="panel-close" bindtap="onClose">×</view>
      <text class="panel-title">{{current.book || '摘抄'}}</text>
      <view class="head-act" data-id="{{current.id}}" bindtap="onToggleFav">{{current.favorite ? '★' : '☆'}}</view>
    </view>
    <scroll-view class="panel-body" scroll-y>
      <text class="ex-content">{{current.content}}</text>

      <view class="list-item-meta">
        <text class="tag" wx:for="{{current.tags}}" wx:key="*this">#{{item}}</text>
      </view>

      <view class="divider"></view>
      <view class="row-between">
        <text class="flag" style="background: {{current.statusColor}}1F; color: {{current.statusColor}};">{{current.statusLabel}}</text>
        <view class="head-act" data-id="{{current.id}}" bindtap="onCycleStatus">切换状态 ›</view>
      </view>
      <text class="t-caption">{{current.date}}</text>

      <view class="divider"></view>
      <text class="t-caption">笔记</text>
      <text class="d-notes" wx:if="{{current.note}}">{{current.note}}</text>
      <text class="t-caption" wx:else>（无）</text>

      <view class="actions">
        <view class="act btn-ghost" bindtap="onCopy">复制</view>
        <view class="act btn-danger" data-id="{{current.id}}" bindtap="onDelete">删除</view>
      </view>
    </scroll-view>
  </view>

  <!-- 新增 -->
  <view class="panel" wx:if="{{showAdd}}">
    <view class="panel-head">
      <view class="panel-close" bindtap="onCloseAdd">×</view>
      <text class="panel-title">添加摘抄</text>
      <view style="width: 64rpx;"></view>
    </view>
    <scroll-view class="panel-body" scroll-y>
      <view class="field">
        <text class="field-label">内容</text>
        <textarea class="textarea" value="{{form.content}}" data-field="content" bindinput="onAddInput" placeholder="摘录的原文…" />
      </view>
      <view class="field">
        <text class="field-label">来源</text>
        <input class="input" value="{{form.book}}" data-field="book" bindinput="onAddInput" placeholder="书名或来源" />
      </view>
      <view class="field">
        <text class="field-label">标签（逗号分隔）</text>
        <input class="input" value="{{form.tags}}" data-field="tags" bindinput="onAddInput" placeholder="arch, product" />
      </view>
      <view class="field">
        <text class="field-label">笔记</text>
        <textarea class="textarea" value="{{form.note}}" data-field="note" bindinput="onAddInput" placeholder="你的思考…" />
      </view>
      <view class="btn-primary" bindtap="onSave">保存</view>
    </scroll-view>
  </view>
</view>