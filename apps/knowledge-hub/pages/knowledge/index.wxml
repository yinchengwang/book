<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <view class="page-body">

    <view class="page-head">
      <text class="page-title">知识</text>
      <text class="page-sub">{{stats.nodes}} 个节点 · {{stats.excerpts}} 条摘抄</text>
    </view>

    <view
      class="entry"
      wx:for="{{entries}}"
      wx:key="key"
      data-path="{{item.path}}"
      bindtap="onOpen"
    >
      <view class="entry-symbol" style="background: {{item.color}}1F; color: {{item.color}};">{{item.symbol}}</view>
      <view class="entry-main">
        <view class="entry-head">
          <text class="entry-title">{{item.title}}</text>
          <text class="entry-count num">{{item.count}}</text>
        </view>
        <text class="entry-desc">{{item.desc}}</text>
      </view>
      <view class="entry-arrow"></view>
    </view>

    <!-- 能力差距 -->
    <view class="group-title">能力差距</view>
    <view class="card">
      <view class="gap-row" wx:for="{{gaps}}" wx:key="key">
        <view class="row-between">
          <text class="gap-label">{{item.label}}</text>
          <text class="gap-num num">{{item.level}} / {{item.target}}</text>
        </view>
        <progress-bar percent="{{item.percent}}" color="{{item.color}}" />
        <text class="gap-hint" wx:if="{{item.urgent}}">差距 {{item.gap}} 分，建议优先补强</text>
      </view>
    </view>

    <view class="bottom-space"></view>
  </view>
</view>