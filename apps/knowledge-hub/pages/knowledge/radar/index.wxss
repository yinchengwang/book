/* 技术雷达 */

.chips {
  margin: 16rpx 0;
}

.stack-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}

.stack-row + .stack-row {
  border-top: 0.5px solid var(--border);
}

.stack-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.stack-label {
  font-size: 26rpx;
  color: var(--text-primary);
}

.stack-count {
  font-size: 22rpx;
  color: var(--text-muted);
}

.gap-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.gap-score {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.gap-advice {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.gap-advice.is-urgent {
  color: var(--warning);
}