<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <view class="page-body">

    <view class="page-head">
      <text class="page-title">技术雷达</text>
      <text class="page-sub">{{stats.items}} 个知识点 · 栈均进度 {{stats.avgPercent}}%</text>
    </view>

    <!-- 模式切换 -->
    <view class="chips">
      <view
        class="chip {{mode === item.key ? 'is-active' : ''}}"
        wx:for="{{modes}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onMode"
      >{{item.label}}</view>
    </view>

    <!-- 知识点气泡 -->
    <block wx:if="{{mode === 'quadrant'}}">
      <radar-chart mode="quadrant" items="{{items}}" is-dark="{{isDark}}" />

      <view class="chips">
        <view
          class="chip {{activeQuadrant === item ? 'is-active' : ''}}"
          wx:for="{{quadrants}}"
          wx:key="*this"
          data-key="{{item}}"
          bindtap="onPickQuadrant"
        >{{item}}</view>
      </view>
      <view class="chips">
        <view
          class="chip {{activeRing === item ? 'is-active' : ''}}"
          wx:for="{{rings}}"
          wx:key="*this"
          data-key="{{item}}"
          bindtap="onPickRing"
        >{{item}}</view>
      </view>

      <view class="list-item" wx:for="{{list}}" wx:key="id">
        <view class="list-item-bar" style="background: {{item.color}};"></view>
        <view class="list-item-head">
          <text class="list-item-title">{{item.title}}</text>
          <text class="list-item-time">{{item.ringLabel}}</text>
        </view>
        <text class="list-item-sub">{{item.desc}}</text>
      </view>
      <app-empty wx:if="{{list.length === 0}}" text="没有匹配的知识点" />
    </block>

    <!-- 技术栈雷达 -->
    <block wx:if="{{mode === 'stack'}}">
      <radar-chart mode="stack" rows="{{rows}}" is-dark="{{isDark}}" />

      <view class="card">
        <view class="stack-row" wx:for="{{rows}}" wx:key="key">
          <view class="stack-dot" style="background: {{item.color}};"></view>
          <view class="grow">
            <view class="row-between">
              <text class="stack-label">{{item.label}}</text>
              <text class="stack-count num">{{item.answered}}/{{item.total}} · {{item.percent}}%</text>
            </view>
            <progress-bar percent="{{item.percent}}" color="{{item.color}}" />
          </view>
        </view>
      </view>
    </block>

    <!-- 能力差距（原 gap_analysis 合并） -->
    <block wx:if="{{mode === 'gap'}}">
      <view class="card" wx:for="{{gaps}}" wx:key="key">
        <view class="row-between">
          <text class="gap-title">{{item.label}}</text>
          <text class="gap-score num">{{item.level}} / {{item.target}}</text>
        </view>
        <progress-bar percent="{{item.percent}}" color="{{item.color}}" />
        <text class="gap-advice {{item.urgent ? 'is-urgent' : ''}}">{{item.advice}}</text>
      </view>
    </block>

    <view class="bottom-space"></view>
  </view>
</view>