<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <view class="page-body">

    <view class="page-head">
      <text class="page-title">面试</text>
      <text class="page-sub">{{stats.active}} 家进行中 · {{stats.mocks}} 场模拟</text>
    </view>

    <view
      class="entry"
      wx:for="{{entries}}"
      wx:key="key"
      data-path="{{item.path}}"
      bindtap="onOpen"
    >
      <view class="entry-symbol" style="background: {{item.color}}1F; color: {{item.color}};">{{item.symbol}}</view>
      <view class="entry-main">
        <view class="entry-head">
          <text class="entry-title">{{item.title}}</text>
          <text class="entry-count num">{{item.count}}</text>
        </view>
        <text class="entry-desc">{{item.desc}}</text>
      </view>
      <view class="entry-arrow"></view>
    </view>

    <!-- 进行中的流程 -->
    <view class="group-title" wx:if="{{upcoming.length}}">进行中</view>
    <view class="card" wx:for="{{upcoming}}" wx:key="id">
      <view class="row-between">
        <text class="up-name">{{item.name}}</text>
        <text class="flag" style="background: {{item.color}}1F; color: {{item.color}};">{{item.status}}</text>
      </view>
      <text class="t-caption">{{item.position}}</text>
    </view>

    <view class="bottom-space"></view>
  </view>
</view>