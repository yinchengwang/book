/* 模拟面试 —— 配置 / 倒计时答题 / 报告 */

.timer {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--brand);
}

.q-stem {
  display: block;
  margin: 20rpx 0;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.6;
}

.q-stem-sm {
  display: block;
  margin: 12rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.6;
}

.score-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
}

.score-num {
  font-size: 96rpx;
  font-weight: 600;
  color: var(--brand);
  line-height: 1.1;
}

.score-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.card + .card {
  margin-top: 16rpx;
}

.tl-type {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.fb {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.fb-sug {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--warning);
}

.tag-del {
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--danger);
  background: rgba(229, 72, 77, 0.12);
  display: flex;
  align-items: center;
}