<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <view class="page-body">

    <!-- ========== 配置 ========== -->
    <block wx:if="{{step === 'config'}}">
      <view class="page-head">
        <text class="page-title">模拟面试</text>
        <text class="page-sub">本地规则评分，答完出报告</text>
      </view>

      <view class="card">
        <view class="field">
          <text class="field-label">岗位</text>
          <view class="chips">
            <view
              class="chip {{config.role === item ? 'is-active' : ''}}"
              wx:for="{{roles}}"
              wx:key="*this"
              data-field="role" data-value="{{item}}"
              bindtap="onPick"
            >{{item}}</view>
          </view>
        </view>

        <view class="field">
          <text class="field-label">难度</text>
          <view class="chips">
            <view
              class="chip {{config.difficulty === item ? 'is-active' : ''}}"
              wx:for="{{levels}}"
              wx:key="*this"
              data-field="difficulty" data-value="{{item}}"
              bindtap="onPick"
            >{{item}}</view>
          </view>
        </view>

        <view class="two-col">
          <view class="col field">
            <text class="field-label">时长（分钟）</text>
            <view class="chips">
              <view
                class="chip {{config.minutes === item ? 'is-active' : ''}}"
                wx:for="{{[10,20,30,45]}}"
                wx:key="*this"
                data-field="minutes" data-value="{{item}}" data-type="number"
                bindtap="onPick"
              >{{item}}</view>
            </view>
          </view>
          <view class="col field">
            <text class="field-label">题目数</text>
            <view class="chips">
              <view
                class="chip {{config.count === item ? 'is-active' : ''}}"
                wx:for="{{[2,3,5]}}"
                wx:key="*this"
                data-field="count" data-value="{{item}}" data-type="number"
                bindtap="onPick"
              >{{item}}</view>
            </view>
          </view>
        </view>

        <view class="btn-primary" bindtap="onStart">开始面试</view>
      </view>

      <!-- 历史 -->
      <view class="group-title" wx:if="{{history.length}}">历史记录</view>
      <view
        class="list-item"
        wx:for="{{history}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onOpenHistory"
      >
        <view class="list-item-bar" style="background: {{brand}};"></view>
        <view class="list-item-head">
          <text class="list-item-title">{{item.role}} · {{item.difficulty}}</text>
          <text class="list-item-time">{{item.totalScore}} 分</text>
        </view>
        <view class="list-item-meta">
          <text class="tag">{{item.date}}</text>
          <text class="tag">{{item.questions.length}} 题</text>
          <view class="row tag-del" data-id="{{item.id}}" catchtap="onDeleteHistory">删除</view>
        </view>
      </view>
    </block>

    <!-- ========== 答题 ========== -->
    <block wx:if="{{step === 'interview'}}">
      <view class="card">
        <view class="row-between">
          <text class="t-caption num">第 {{index + 1}} / {{questions.length}} 题</text>
          <text class="timer num">{{remaining}}</text>
        </view>
        <text class="q-stem">{{questions[index].question}}</text>
        <view class="field">
          <textarea
            class="textarea"
            value="{{answers[index]}}"
            bindinput="onAnswer"
            placeholder="分点作答，尽量具体"
          />
        </view>
        <view class="actions">
          <view class="act btn-ghost" wx:if="{{index > 0}}" bindtap="onPrev">上一题</view>
          <view class="act btn-primary" bindtap="onNext">{{index === questions.length - 1 ? '结束并评分' : '下一题'}}</view>
        </view>
      </view>
    </block>

    <!-- ========== 结果 ========== -->
    <block wx:if="{{step === 'result'}}">
      <view class="page-head">
        <text class="page-title">面试报告</text>
        <text class="page-sub">本地规则评分</text>
      </view>

      <view class="card score-card">
        <text class="score-num num">{{result.score}}</text>
        <text class="score-label">综合得分</text>
      </view>

      <view class="card" wx:for="{{result.questions}}" wx:key="question" wx:for-index="qi">
        <view class="row-between">
          <text class="tl-type">第 {{qi + 1}} 题</text>
          <text class="flag" style="background: {{item.evaluation.score >= 75 ? 'rgba(48,164,108,0.14)' : 'rgba(229,72,77,0.12)'}}; color: {{item.evaluation.score >= 75 ? '#30A46C' : '#E5484D'}};">{{item.evaluation.score}} 分</text>
        </view>
        <text class="q-stem-sm">{{item.question}}</text>
        <text class="t-caption">你的回答：{{item.answer || '（未作答）'}}</text>
        <text class="fb">{{item.evaluation.feedback}}</text>
        <text class="fb-sug" wx:for="{{item.evaluation.suggestions}}" wx:for-item="s" wx:key="*this">· {{s}}</text>
      </view>

      <view class="btn-primary" bindtap="onBackConfig">返回配置</view>
      <view class="bottom-space"></view>
    </block>

  </view>
</view>