<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <view class="page-body">

    <view class="page-head">
      <text class="page-title">项目路线</text>
      <text class="page-sub">{{stats.doing}} 进行中 · {{stats.done}} 已完成</text>
    </view>

    <view class="chips">
      <view
        class="chip {{filter === item.key ? 'is-active' : ''}}"
        wx:for="{{statuses}}"
        wx:key="key"
        data-status="{{item.key}}"
        bindtap="onPickFilter"
      >{{item.label}}</view>
    </view>

    <view
      class="list-item"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOpen"
    >
      <view class="list-item-bar" style="background: {{item.statusColor}};"></view>
      <view class="list-item-head">
        <text class="list-item-title">{{item.name}}</text>
        <text class="list-item-time">{{item.updatedAt}}</text>
      </view>
      <text class="list-item-sub">{{item.description}}</text>
      <view class="list-item-meta">
        <text class="flag" style="background: {{item.statusColor}}1F; color: {{item.statusColor}};">{{item.statusLabel}}</text>
        <text class="tag" style="color: {{item.priorityColor}};">{{item.priorityLabel}}优先</text>
        <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">#{{t}}</text>
      </view>
    </view>

    <app-empty wx:if="{{list.length === 0}}" text="还没有学习项目" action-text="添加项目" bind:action="onOpenAdd" />
    <view class="bottom-space"></view>
  </view>

  <app-fab bottom="{{140}}" bind:tap="onOpenAdd" />

  <!-- 详情 -->
  <view class="panel" wx:if="{{current}}">
    <view class="panel-head">
      <view class="panel-close" bindtap="onClose">×</view>
      <text class="panel-title">项目详情</text>
      <view style="width: 64rpx;"></view>
    </view>
    <scroll-view class="panel-body" scroll-y>
      <view class="card">
        <text class="d-name">{{current.name}}</text>
        <text class="d-desc">{{current.description}}</text>
        <view class="list-item-meta">
          <text class="flag" style="background: {{current.statusColor}}1F; color: {{current.statusColor}};">{{current.statusLabel}}</text>
          <text class="tag" style="color: {{current.priorityColor}};">{{current.priorityLabel}}优先</text>
        </view>
      </view>

      <view class="group-title">切换状态</view>
      <view class="chips">
        <view
          class="chip {{current.status === item.key ? 'is-active' : ''}}"
          wx:for="{{statuses}}"
          wx:key="key"
          data-id="{{current.id}}"
          data-status="{{item.key}}"
          bindtap="onChangeStatus"
        >{{item.label}}</view>
      </view>

      <view class="group-title" wx:if="{{current.knowledgeLinks.length}}">关联知识点</view>
      <view class="card" wx:if="{{current.knowledgeLinks.length}}">
        <view class="rel-line" wx:for="{{current.knowledgeLinks}}" wx:key="id">
          <text class="grow">{{item.name}}</text>
        </view>
      </view>

      <view class="btn-danger delete" bindtap="onDelete">删除项目</view>
    </scroll-view>
  </view>

  <!-- 新增 -->
  <view class="panel" wx:if="{{showAdd}}">
    <view class="panel-head">
      <view class="panel-close" bindtap="onCloseAdd">×</view>
      <text class="panel-title">添加学习项目</text>
      <view style="width: 64rpx;"></view>
    </view>
    <scroll-view class="panel-body" scroll-y>
      <view class="field">
        <text class="field-label">项目名</text>
        <input class="input" value="{{form.name}}" data-field="name" bindinput="onAddInput" placeholder="例如：手写 STL" />
      </view>
      <view class="field">
        <text class="field-label">描述</text>
        <textarea class="textarea" value="{{form.description}}" data-field="description" bindinput="onAddInput" placeholder="想达成什么？" />
      </view>
      <view class="field">
        <text class="field-label">状态</text>
        <view class="chips">
          <view
            class="chip {{form.status === item.key ? 'is-active' : ''}}"
            wx:for="{{statuses}}"
            wx:key="key"
            data-field="status" data-value="{{item.key}}"
            bindtap="onPickForm"
          >{{item.label}}</view>
        </view>
      </view>
      <view class="field">
        <text class="field-label">优先级</text>
        <view class="chips">
          <view
            class="chip {{form.priority === item.key ? 'is-active' : ''}}"
            wx:for="{{priorities}}"
            wx:key="key"
            data-field="priority" data-value="{{item.key}}"
            bindtap="onPickForm"
          >{{item.label}}</view>
        </view>
      </view>
      <view class="field">
        <text class="field-label">标签（逗号分隔）</text>
        <input class="input" value="{{form.tags}}" data-field="tags" bindinput="onAddInput" placeholder="cpp, ds" />
      </view>
      <view class="btn-primary" bindtap="onSave">添加</view>
    </scroll-view>
  </view>
</view>