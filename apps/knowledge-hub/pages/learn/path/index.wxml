<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <view class="page-body">

    <view class="page-head">
      <text class="page-title">学习路径</text>
      <text class="page-sub">分步进阶，勾选子任务累计进度</text>
    </view>

    <!-- 路径切换 -->
    <scroll-view class="path-scroll" scroll-x>
      <view class="path-tabs">
        <view
          class="path-tab {{activeId === item.id ? 'is-on' : ''}}"
          wx:for="{{paths}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onPickPath"
        >
          <text class="path-tab-name">{{item.name}}</text>
          <text class="path-tab-meta num">{{item.done}}/{{item.total}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 步骤 -->
    <view class="card step-card" wx:for="{{steps}}" wx:key="id">
      <view class="row-between">
        <text class="step-title">{{item.index + 1}}. {{item.title}}</text>
        <text class="tag">{{item.difficulty}}</text>
      </view>
      <text class="step-desc">{{item.description}}</text>

      <view class="progress-row">
        <progress-bar percent="{{item.percent}}" color="{{brand}}" />
        <text class="progress-text num">{{item.done}}/{{item.total}} · {{item.estimatedHours}}h</text>
      </view>

      <view class="sub-list">
        <view
          class="sub-item"
          wx:for="{{item.subSteps}}"
          wx:for-item="sub"
          wx:key="id"
          data-step="{{item.id}}"
          data-sub="{{sub.id}}"
          bindtap="onToggleSub"
        >
          <view class="check {{sub.done ? 'is-on' : ''}}">{{sub.done ? '✓' : ''}}</view>
          <view class="grow">
            <text class="sub-title {{sub.done ? 'is-done' : ''}}">{{sub.title}}</text>
          </view>
          <text class="tag" style="color: {{sub.typeColor}};">{{sub.typeLabel}}</text>
          <text class="sub-hours num">{{sub.hours}}h</text>
        </view>
      </view>

      <view class="res-list" wx:if="{{item.resources.length}}">
        <text class="res-label">参考</text>
        <text class="res-item" wx:for="{{item.resources}}" wx:for-item="r" wx:key="*this">{{r}}</text>
      </view>
    </view>

    <view class="btn-ghost reset-btn" bindtap="onReset">重置当前路径进度</view>
    <view class="bottom-space"></view>
  </view>
</view>