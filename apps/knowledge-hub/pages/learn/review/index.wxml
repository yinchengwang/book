<view class="page {{themeClass}}" style="--brand: {{brand}}; --brand-soft: {{brandSoft}};">
  <view class="page-body">

    <view class="page-head">
      <text class="page-title">复习计划</text>
      <text class="page-sub">待复习 {{stats.due}} · 已掌握 {{stats.done}}</text>
    </view>

    <!-- 三个 tab -->
    <view class="chips">
      <view
        class="chip {{tab === 'due' ? 'is-active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onSwitchTab"
      >
        {{item.label}} {{item.key === 'due' ? stats.due : (item.key === 'all' ? stats.all : stats.done)}}
      </view>
    </view>

    <!-- 卡片 -->
    <view class="card flashcard" wx:if="{{current}}">
      <view class="row-between">
        <text class="tag tag-brand">{{current.domain}}</text>
        <text class="t-caption">第 {{current.repetitions}} 次 · 间隔 {{current.interval}} 天</text>
      </view>

      <text class="q-title">{{current.question}}</text>

      <view class="a-box" wx:if="{{revealed}}">
        <text class="a-text">{{current.answer}}</text>
      </view>

      <view class="btn-ghost reveal-btn" wx:if="{{!revealed}}" bindtap="onReveal">显示答案</view>

      <!-- 0-5 评分 -->
      <view class="quality-grid" wx:if="{{revealed}}">
        <view
          class="quality-pill"
          wx:for="{{qualities}}"
          wx:key="q"
          data-q="{{item.q}}"
          bindtap="onRate"
          style="border-color: {{item.color}}; color: {{item.color}};"
        >{{item.q}}</view>
      </view>
      <text class="t-caption quality-hint" wx:if="{{revealed}}">按回忆质量打分，决定下次间隔</text>
    </view>

    <app-empty
      wx:else
      text="这个分组还没有卡片"
      action-text="添加卡片"
      bind:action="onOpenAdd"
    />

    <!-- 队列 -->
    <view class="group-title" wx:if="{{list.length}}">队列（{{list.length}}）</view>
    <view
      class="list-item"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onNextCard"
    >
      <view class="list-item-bar" style="background: {{brand}};"></view>
      <view class="list-item-head">
        <text class="list-item-title ellipsis">{{item.question}}</text>
        <text class="list-item-time">{{item.next}}</text>
      </view>
      <view class="list-item-meta">
        <text class="tag">{{item.domain}}</text>
        <text class="tag">ease {{item.easiness}}</text>
        <view class="row tag-del" data-id="{{item.id}}" catchtap="onDelete">删除</view>
      </view>
    </view>

    <view class="bottom-space"></view>
  </view>

  <!-- 新增卡片 -->
  <view class="panel" wx:if="{{showAdd}}">
    <view class="panel-head">
      <view class="panel-close" bindtap="onCloseAdd">×</view>
      <text class="panel-title">新增复习卡片</text>
      <view style="width: 64rpx;"></view>
    </view>
    <scroll-view class="panel-body" scroll-y>
      <view class="field">
        <text class="field-label">问题</text>
        <textarea class="textarea" value="{{form.question}}" data-field="question" bindinput="onInput" placeholder="例如：什么是时间复杂度？" />
      </view>
      <view class="field">
        <text class="field-label">答案</text>
        <textarea class="textarea" value="{{form.answer}}" data-field="answer" bindinput="onInput" placeholder="写下答案要点" />
      </view>
      <view class="field">
        <text class="field-label">分类</text>
        <input class="input" value="{{form.domain}}" data-field="domain" bindinput="onInput" placeholder="算法 / C/C++ / 网络…" />
      </view>
      <view class="btn-primary" bindtap="onSaveCard">加入复习队列</view>
    </scroll-view>
  </view>
</view>