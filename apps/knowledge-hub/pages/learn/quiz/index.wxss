/* 题库练习 —— 5 模式 + 底部模式条 */

.plan-num {
  margin: 16rpx 0 12rpx;
}

.plan-done {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.plan-total {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.search-chips {
  margin-bottom: 16rpx;
}

.chip-static {
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  background: var(--bg-tertiary);
  display: flex;
  align-items: center;
}

.q-meta {
  margin-top: 16rpx;
}

.q-stem {
  display: block;
  margin: 20rpx 0;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.6;
}

.opt {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  border: 0.5px solid var(--border);
  background: var(--bg-secondary);
  margin-bottom: 12rpx;
}

.opt:active {
  background: var(--bg-tertiary);
}

.opt-letter {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--bg-tertiary);
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.opt-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

.opt-mark {
  color: var(--success);
  font-size: 28rpx;
  font-weight: 600;
}

.result-box {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.result-box.is-ok {
  background: rgba(48, 164, 108, 0.12);
}

.result-box.is-no {
  background: rgba(229, 72, 77, 0.12);
}

.result-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.result-explain {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.exit-btn {
  margin-top: 16rpx;
  height: 76rpx;
  font-size: 26rpx;
}

.stat-grid {
  display: flex;
  gap: 16rpx;
}

.stat-cell {
  flex: 1;
  background: var(--bg-secondary);
  border: 0.5px solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.stack-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}

.stack-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.stack-label {
  font-size: 26rpx;
  color: var(--text-primary);
}

.stack-count {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 底部模式条 */
.modebar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  display: flex;
  background: var(--bg-secondary);
  border-top: 0.5px solid var(--border);
  padding-bottom: env(safe-area-inset-bottom);
}

.mode-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.mode-item.is-on {
  color: var(--brand);
  font-weight: 600;
}