/**
 * @file multimodal_config.h.in
 * @brief 多模态编译配置头文件模板
 *
 * 由 CMake configure_file() 自动生成
 * 使用 #cmakedefine 使能时生成 #define，禁用时不生成
 *
 * 用法示例:
 *   #ifdef MMDB_ENABLE_VECTOR
 *       // 向量引擎相关代码
 *   #endif
 */
#ifndef DB_MULTIMODAL_CONFIG_H
#define DB_MULTIMODAL_CONFIG_H

/* Auto-generated by CMake. Do not edit manually. */

/* ========================================================================
 * 顶层模态开关
 * ======================================================================== */

#cmakedefine MMDB_ENABLE_RELATIONAL
#cmakedefine MMDB_ENABLE_KV
#cmakedefine MMDB_ENABLE_GRAPH
#cmakedefine MMDB_ENABLE_VECTOR
#cmakedefine MMDB_ENABLE_TIMESERIES
#cmakedefine MMDB_ENABLE_DOCUMENT
#cmakedefine MMDB_ENABLE_SPATIAL
#cmakedefine MMDB_ENABLE_TREE
#cmakedefine MMDB_ENABLE_STREAM
#cmakedefine MMDB_ENABLE_COLUMNAR

/* ========================================================================
 * 分布式能力开关
 * ======================================================================== */

#cmakedefine MMDB_ENABLE_DISTRIBUTED
#cmakedefine MMDB_ENABLE_DISTRIBUTED_RAFT
#cmakedefine MMDB_ENABLE_DISTRIBUTED_SHARD

#endif /* DB_MULTIMODAL_CONFIG_H */
