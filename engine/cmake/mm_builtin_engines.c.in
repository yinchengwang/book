/* ========================================================================
 * mm_builtin_engines.c —— 构建期生成文件（勿手改）
 *
 * 由 cmake/gen_builtin_engines.cmake 按当前 profile 的 MMDB_ENABLE_*
 * 开关 configure_file() 生成到 <build>/generated/src/。
 * 空 profile 也会生成本文件（两个函数体为空），保证
 * engine_registry_init / mm_storage_init 的链接永远成立。
 * ======================================================================== */
#include "db/mm_engine_register.h"
#include "db/storage_engine.h"

void mm_register_builtin_engines(void) {
@MMDB_ENGINE_REGISTER_CALLS@}

void mm_register_builtin_sql_functions(void) {
@MMDB_SQL_FUNCTION_REGISTER_CALLS@}
