/* ========================================================================
 * mm_smoke_expect.h —— 构建期生成文件（勿手改）
 *
 * 由 cmake/mm_smoke.cmake 按当前 profile 的 MMDB_EXPECTED_ENGINE_MASK
 * 生成到 <build>/generated/include/。
 *
 * MM_SMOKE_EXPECTED_ENGINE_MASK 是本 profile 下「应当被注册」的
 * storage 引擎槽位位掩码（位序 = DataModel 枚举值）：
 *   RELATIONAL=0 KV=1 GRAPH=2 VECTOR=3 TIMESERIES=4 DOCUMENT=5
 *   SPATIAL=6 TREE=7 STREAM=8 COLUMNAR=9 RDF=11 SPATIOTEMPORAL=12
 *
 * 冒烟断言用它替代硬编码的引擎计数：注册表中的非空槽位集合必须
 * 恰好等于该掩码。单模态 profile 下掩码只有本模态一位，
 * 等价于「只注册本模态引擎」的原始断言；legacy/full profile 下
 * 掩码覆盖全部启用模态，冒烟同样成立。
 * ======================================================================== */
#ifndef DB_MM_SMOKE_EXPECT_H
#define DB_MM_SMOKE_EXPECT_H

#define MM_SMOKE_EXPECTED_ENGINE_MASK @MMDB_EXPECTED_ENGINE_MASK@u

#endif /* DB_MM_SMOKE_EXPECT_H */
